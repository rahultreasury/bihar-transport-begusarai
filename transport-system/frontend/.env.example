# Frontend Environment Configuration
# Copy this file to .env (development) or configure in Render/Netlify (production)
# NEVER commit .env files to version control

# ============================================
# GOOGLE MAPS API (Required)
# ============================================
# Get your API key from: https://console.cloud.google.com/google/maps-apis/
# 1. Create a project in Google Cloud Console
# 2. Enable Maps JavaScript API and Places API
# 3. Create API credentials (API Key)
# 4. Add your API key below
VITE_GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_API_KEY

# ============================================
# BACKEND API URL — ENVIRONMENT SEPARATION (CRITICAL)
# ============================================
# LOCAL DEVELOPMENT: Do NOT set VITE_API_URL
#   The frontend uses relative URLs (/api) and Vite proxy forwards to backend
#   Vite proxy config: /api → http://localhost:3000 (vite.config.js)
#
# PRODUCTION (Render/Netlify): Set explicitly
#   VITE_API_URL=https://bihar-transport-begusarai-1.onrender.com/api
#
# NEVER use production API URL in local development.
# NEVER use local API URL in production.

# Development: Comment out or leave unset
# VITE_API_URL=

# Production: Uncomment and set
# VITE_API_URL=https://bihar-transport-begusarai-1.onrender.com/api

# ============================================
# CUSTOMER CARE (Optional - fallback defaults)
# ============================================
# Authoritative values come from backend (GET /api/enquiries/config/customer-care)
# These exist only so the support card is never blank before first fetch.
VITE_CUSTOMER_CARE_PHONE=8210931799
VITE_CUSTOMER_CARE_WHATSAPP=8210931799
VITE_CUSTOMER_CARE_PHOTO=/assets/customer-care.png