# Bihar Transport ERP - Environment Configuration
# Copy this file to .env and replace placeholders with actual values
# NEVER commit .env files to version control

# ============================================
# REQUIRED (All Environments)
# ============================================
# JWT secret for authentication - MUST be at least 32 random characters
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
JWT_SECRET=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET

# ============================================
# DATABASE — EXACT HOSTNAME VALIDATION (CRITICAL)
# ============================================
# The application validates DATABASE_URL against EXPLICITLY APPROVED hostnames.
# Hostnames MUST be obtained from Neon Console → Project → Branches → Connection Details.
# NO pattern matching — exact hostname comparison only.

# --- DEVELOPMENT (direct connection, no -pooler.) ---
# Get from Neon Console: bihar-transport-recovery-test branch → Connection Details → Direct
DEV_DB_HOSTNAME=REPLACE_WITH_DEV_EXACT_HOSTNAME
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_WITH_DEV_EXACT_HOSTNAME/neondb?sslmode=require
DIRECT_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_WITH_DEV_EXACT_HOSTNAME/neondb?sslmode=require

# --- PRODUCTION (Render) ---
# Pooled: for application runtime (has -pooler.)
# Get from Neon Console: production branch → Connection Details → Pooled
PROD_DB_POOLED_HOSTNAME=REPLACE_WITH_PROD_POOLED_EXACT_HOSTNAME
# Direct: for Prisma migrations (no -pooler.)
# Get from Neon Console: production branch → Connection Details → Direct
PROD_DB_DIRECT_HOSTNAME=REPLACE_WITH_PROD_DIRECT_EXACT_HOSTNAME

# --- PROTECTED SNAPSHOT (ALWAYS BLOCKED) ---
# Get from Neon Console: pre-finance-recovery-2026-11-03 branch → Connection Details
FORBIDDEN_DB_HOSTNAME=REPLACE_WITH_SNAPSHOT_EXACT_HOSTNAME

# Environment selector — REQUIRED
# Development: EXPECTED_DB_BRANCH=development
# Production:  EXPECTED_DB_BRANCH=production
EXPECTED_DB_BRANCH=development

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
ENV_STRICT=true

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5174

# ============================================
# EMAIL (Brevo SMTP) - Optional
# ============================================
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=REPLACE_WITH_BREVO_SMTP_USER
BREVO_SMTP_PASSWORD=REPLACE_WITH_BREVO_SMTP_PASSWORD
FROM_EMAIL=REPLACE_FROM_EMAIL
OWNER_EMAIL=REPLACE_OWNER_EMAIL

# ============================================
# EXTERNAL APIS - Optional
# ============================================
# Google Maps API for distance calculation
GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_API_KEY

# Gemini AI API
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# ============================================
# WHATSAPP INTEGRATION - Optional
# ============================================
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_WHATSAPP_TOKEN
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
WHATSAPP_BUSINESS_NUMBER=REPLACE_WITH_BUSINESS_NUMBER

# ============================================
# SMS INTEGRATION - Optional
# ============================================
SMS_PROVIDER=REPLACE_PROVIDER
SMS_API_KEY=REPLACE_WITH_SMS_API_KEY
SMS_SENDER_ID=REPLACE_SENDER_ID
SMS_TEMPLATE_ID=REPLACE_TEMPLATE_ID
SMS_TEMPLATE_NAME=REPLACE_TEMPLATE_NAME

# ============================================
# MANUAL ORDER CREATION (Admin Create Order)
# ============================================
# Reserved system customer user that owns manually created (admin phone/offline)
# orders. bookings.user_id is the customer/guest account and must NOT be the
# acting admin's id, so manual orders are anchored to this reserved customer
# user; the acting admin is recorded in the audit log / timeline as creator.
# Set to the user_id of an existing customer (role=customer) user. No default.
MANUAL_ORDER_SYSTEM_USER_ID=REPLACE_WITH_EXISTING_CUSTOMER_USER_ID

# ============================================
# CUSTOMER CARE - Optional
# ============================================
CUSTOMER_CARE_NAME=Bihar Transport Customer Care
CUSTOMER_CARE_DESIGNATION=Customer Care Executive
CUSTOMER_CARE_PHONE=REPLACE_PHONE_NUMBER
CUSTOMER_CARE_WHATSAPP=REPLACE_WHATSAPP_NUMBER
