# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# SMS Provider Configuration (for OTP authentication)
# SMS_PROVIDER=dev|msg91|2factor|textlocal
# SMS_API_KEY=your-sms-api-key
# SMS_SENDER_ID=BTINFO
# SMS_TEMPLATE_ID=your-template-id (for MSG91)
# SMS_TEMPLATE_NAME=OTP (for 2Factor)

# Development admin password (used by scripts/seed-admin.js and scripts/change-admin-password.js)
# ADMIN_PASSWORD=your-dev-admin-password

# ============================================================
# ENQUIRY MODULE — CUSTOMER CARE (Bihar Transport support)
# ============================================================
# This is the customer's ONLY phone contact for a transport enquiry.
# Driver mobile numbers are never exposed to customers (see dtos/EnquiryDTO.js).
# Change the support number here — NEVER in a React component.
#
# CUSTOMER_CARE_NAME       Support executive display name
# CUSTOMER_CARE_DESIGNATION Job title shown under the name
# CUSTOMER_CARE_PHONE      Dialable number; any format is normalised
#                         ("9876543210", "+91 98765 43210" both work)
# CUSTOMER_CARE_WHATSAPP   WhatsApp-enabled number (falls back to PHONE)
# CUSTOMER_CARE_PHOTO      Absolute or public-relative photo URL
#                         (e.g. /assets/customer-care.jpg)
# CUSTOMER_CARE_HOURS      Support hours text
# CUSTOMER_CARE_EMAIL      Support mailbox
# BRAND_NAME               Brand name used in generated WhatsApp messages
CUSTOMER_CARE_NAME=Bihar Transport Customer Care
CUSTOMER_CARE_DESIGNATION=Customer Care Executive
# CUSTOMER_CARE_PHONE=8210931799
# CUSTOMER_CARE_WHATSAPP=8210931799
# CUSTOMER_CARE_PHOTO=/assets/customer-care.jpg
# CUSTOMER_CARE_HOURS=Mon – Sat, 8:00 AM – 8:00 PM
# CUSTOMER_CARE_EMAIL=support@bihartransport.example
# BRAND_NAME=Bihar Transport

# Lifetime (days) of the guest enquiry-access token issued when a customer
# submits an enquiry WITHOUT logging in. This is what replaced the
# "Submit Booking → forced login" wall: the customer is authorised for their own
# enquiry immediately, and the token expires to bound exposure.
# ENQUIRY_ACCESS_TOKEN_TTL_DAYS=30

# ============================================================
# REALTIME (Socket.IO)
# ============================================================
# Optional. The backend serves the socket from the same HTTP server; the
# frontend derives the origin from VITE_API_URL. Set this only when the socket
# is served from a different host than the REST API.
# CORS origin for the socket defaults to FRONTEND_URL.


