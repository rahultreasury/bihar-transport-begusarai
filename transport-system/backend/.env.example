# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# SMS Provider Configuration (for OTP authentication)
# SMS_PROVIDER=dev|msg91|2factor|textlocal
# SMS_API_KEY=your-sms-api-key
# SMS_SENDER_ID=BTINFO
# SMS_TEMPLATE_ID=your-template-id (for MSG91)
# SMS_TEMPLATE_NAME=OTP (for 2Factor)

# Development admin password (used by scripts/seed-admin.js and scripts/change-admin-password.js)
# ADMIN_PASSWORD=your-dev-admin-password

# ============================================================
# ENQUIRY MODULE — CUSTOMER CARE (Bihar Transport support)
# ============================================================
# This is the customer's ONLY phone contact for a transport enquiry.
# Driver mobile numbers are never exposed to customers (see dtos/EnquiryDTO.js).
# Change the support number here — NEVER in a React component.
#
# CUSTOMER_CARE_NAME       Support executive display name
# CUSTOMER_CARE_DESIGNATION Job title shown under the name
# CUSTOMER_CARE_PHONE      Dialable number; any format is normalised
#                         ("9876543210", "+91 98765 43210" both work)
# CUSTOMER_CARE_WHATSAPP   WhatsApp-enabled number (falls back to PHONE)
# CUSTOMER_CARE_PHOTO      Absolute or public-relative photo URL
#                         (e.g. /assets/customer-care.jpg)
# CUSTOMER_CARE_HOURS      Support hours text
# CUSTOMER_CARE_EMAIL      Support mailbox
# BRAND_NAME               Brand name used in generated WhatsApp messages
CUSTOMER_CARE_NAME=Bihar Transport Customer Care
CUSTOMER_CARE_DESIGNATION=Customer Care Executive
# CUSTOMER_CARE_PHONE=8210931799
# CUSTOMER_CARE_WHATSAPP=8210931799
# CUSTOMER_CARE_PHOTO=/assets/customer-care.jpg
# CUSTOMER_CARE_HOURS=Mon – Sat, 8:00 AM – 8:00 PM
# CUSTOMER_CARE_EMAIL=support@bihartransport.example
# BRAND_NAME=Bihar Transport

# Lifetime (days) of the guest enquiry-access token issued when a customer
# submits an enquiry WITHOUT logging in. This is what replaced the
# "Submit Booking → forced login" wall: the customer is authorised for their own
# enquiry immediately, and the token expires to bound exposure.
# ENQUIRY_ACCESS_TOKEN_TTL_DAYS=30

# ============================================================
# VEHICLE RC LOOKUP — PARSE "CarInfo API" (admin vehicle registration)
# ============================================================
# The admin Vehicle / Resource Registration form calls OUR backend
# (GET /api/vehicles/lookup?vehicleNumber=BR09AB1234); the backend then calls
# the Parse CarInfo API with this key. The browser NEVER sees it.
#
# PARSE_API_KEY     API key from https://parse.bot (CarInfo API / carinfo-app-api)
# PARSE_CARINFO_TIMEOUT_MS  Optional upstream timeout in ms (default 10000)
#
# NEVER hard-code this key, never put it in frontend/.env or a React component,
# never commit it (backend/.env is git-ignored), and never log it.
# PARSE_API_KEY=
# PARSE_CARINFO_TIMEOUT_MS=10000

# ============================================================
# EMAIL — DELIVERY MODE  (read this FIRST)
# ============================================================
# Governed by services/emailDelivery.js, the single delivery layer every email
# passes through. It decides whether a message is REALLY transmitted or merely
# simulated and logged. It changes DELIVERY ONLY — the booking workflow, the
# notification itself, the templates and the return contract are identical in
# every mode, and the booking is created the same way regardless.
#
#   EMAIL_MODE=production     Real email is sent via Brevo SMTP. USE THIS IN
#                             PRODUCTION ONLY.
#   EMAIL_MODE=development    NO real email. The service logs what it WOULD have
#                             sent and returns success to the workflow. This is
#                             the correct setting for local development, so
#                             creating test bookings cannot flood the real
#                             owner's inbox.
#   EMAIL_MODE=test           NO real email, plus external delivery is hard
#                             blocked. Used by `npm test`.
#
# HOW IT IS RESOLVED (deny-by-default, so a missing value is SAFE)
# --------------------------------------------------------------
#   1. NODE_ENV=test                          -> 'test'  (hard, no override)
#   2. EMAIL_MODE set and valid                -> that value
#   3. EMAIL_MODE set but invalid              -> derived from NODE_ENV
#   4. EMAIL_MODE UNSET                        -> 'production' only when
#                                                 NODE_ENV === 'production',
#                                                 otherwise 'development'
#
# Rule 4 is the important one: a developer machine with no EMAIL_MODE and no
# NODE_ENV resolves to 'development', so it sends NO real email even though
# backend/.env holds real Brevo credentials.
#
# SAFETY GUARD
# ------------
# Real delivery additionally requires NODE_ENV=production. If NODE_ENV is
# 'development' (or unset) it stays blocked UNLESS you also set
# EMAIL_ALLOW_REAL_SEND_IN_NON_PRODUCTION=true — an explicit, deliberate
# opt-in, so a stray EMAIL_MODE=production can never leak test mail.
# NODE_ENV=test can NEVER be overridden, whatever the variables say.
#
# In development/test the log looks like:
#
#   [EMAIL:TEST MODE]
#   Would send booking notification
#   To: <OWNER_EMAIL>
#   Subject: 🚚 New Booking Received - BTB-2026-00252
#   Template: booking_notification
#
# Check the active setting any time with:
#   node scripts/diagnose-booking-notification.js
#
# EMAIL_MODE=development

# Escape hatch ONLY. Leave unset/commented in every environment.
# EMAIL_ALLOW_REAL_SEND_IN_NON_PRODUCTION=false

# ============================================================
# EMAIL — BREVO SMTP (nodemailer)
# ============================================================
# Used by services/emailService.js for two SEPARATE notifications:
#
#   1. ENQUIRY notification — a pre-booking enquiry was submitted.
#      Fired by EnquiryService.createEnquiry().
#   2. BOOKING notification — a Booking row now exists.
#      Fired ONCE, from the single canonical BookingService.createBooking(),
#      AFTER the transaction commits, for every entry point (legacy
#      POST /api/booking, POST /api/bookings/create, and the live
#      enquiry -> quote -> customer accepts flow).
#
# BOTH go to OWNER_EMAIL. The customer is never emailed.
#
# The four required values below are read by
# services/BookingNotificationService.js, which logs an explicit
# "[booking] Notification SKIPPED" line if any of them is missing — the
# booking is still saved when that happens, so a missing value must never go
# unnoticed. Check them with:
#   node scripts/diagnose-booking-notification.js
#
# BREVO_SMTP_HOST      smtp-relay.brevo.com
# BREVO_SMTP_PORT      587            (465 switches nodemailer to implicit TLS)
# BREVO_SMTP_USER      Brevo SMTP login
# BREVO_SMTP_PASSWORD  Brevo SMTP key
# FROM_EMAIL           Verified sender in Brevo (the "from" address)
# OWNER_EMAIL          The ONLY recipient of booking notifications
# ADMIN_URL            Optional. Base URL for the "View in Admin Dashboard"
#                      link inside the booking email. Falls back to
#                      http://localhost:3000/admin when unset.
#
# NOTE: transporter.verify() only proves the SMTP connection. Actual sending
# uses sendMail(); watch the `[booking] Provider accepted message` and
# `[booking] Message ID` lines in the Render logs to confirm real delivery.
#
# IMPORTANT: these credentials alone no longer cause real mail to be sent.
# Having valid BREVO_SMTP_* + FROM_EMAIL + OWNER_EMAIL in your local .env is no
# longer enough — services/emailDelivery.js additionally requires
# EMAIL_MODE=production AND NODE_ENV=production (see the DELIVERY MODE block
# above). Local development therefore never reaches the owner's real inbox.
#
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587
# BREVO_SMTP_USER=
# BREVO_SMTP_PASSWORD=
# FROM_EMAIL=
# OWNER_EMAIL=
# ADMIN_URL=

# ============================================================
# REALTIME (Socket.IO)
# ============================================================
# Optional. The backend serves the socket from the same HTTP server; the
# frontend derives the origin from VITE_API_URL. Set this only when the socket
# is served from a different host than the REST API.
# CORS origin for the socket defaults to FRONTEND_URL.


