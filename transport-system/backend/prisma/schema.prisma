generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  user_id             Int                  @id @default(autoincrement())
  first_name          String
  last_name           String
  email               String               @unique
  phone               String               @unique
  password_hash       String
  address             String?
  city                String?
  state               String?              @default("Bihar")
  pincode             String?
  role                UserRole?            @default(customer)
  is_active           Boolean?             @default(true)
  created_at          DateTime?            @default(now())
  updated_at          DateTime?            @default(now())
  bookings            Booking[]
  drivers             Driver[]
  enquiries           Enquiry[]            @relation("enquiry_customer")
  otpVerifications    OtpVerification[]
  partnerApplications PartnerApplication[]
  passwordResetTokens PasswordResetToken[]
  trips               Trip[]

  @@index([email], map: "idx_users_email")
  @@index([phone], map: "idx_users_phone")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime? @default(now())
  user       User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id], map: "idx_password_reset_user")
  @@index([expires_at], map: "idx_password_reset_expires")
  @@map("password_reset_tokens")
}

model OtpVerification {
  id           Int       @id @default(autoincrement())
  user_id      Int?
  phone        String
  otp_hash     String
  expires_at   DateTime
  attempts     Int       @default(0)
  max_attempts Int       @default(3)
  verified_at  DateTime?
  consumed     Boolean   @default(false)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @default(now())
  user         User?     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([phone], map: "idx_otp_phone")
  @@index([expires_at], map: "idx_otp_expires")
  @@index([created_at], map: "idx_otp_created")
  @@index([user_id], map: "idx_otp_user")
  @@map("otp_verifications")
}

model Driver {
  driver_id          Int                 @id @default(autoincrement())
  user_id            Int
  license_number     String?
  license_expiry     String?
  profile_image      String?
  is_available       Boolean?            @default(true)
  is_verified        Boolean?            @default(false)
  rating             Float?              @default(0)
  total_deliveries   Int?                @default(0)
  created_at         DateTime?           @default(now())
  updated_at         DateTime?           @default(now())
  driver_name        String
  mobile             String
  transport_owner_id Int?
  address            String?
  alternate_mobile   String?
  city               String?
  current_balance    Float?              @default(0)
  current_vehicle_id Int?                @unique
  driver_code        String?             @unique
  joining_date       String?
  license_class      String?
  partner_id         Int?
  performance_rating Float?              @default(0)
  pincode            String?
  state              String?             @default("Bihar")
  status             String?             @default("available")
  total_advance      Float?              @default(0)
  total_expenses     Float?              @default(0)
  total_paid         Float?              @default(0)
  bookingAssignments BookingAssignment[] @relation("assigned_driver")
  bookings           Booking[]
  deliveries         Delivery[]
  driverAssignments  DriverAssignment[]  @relation("assigned_driver_history")
  timelineEvents     DriverTimeline[]
  transactions       DriverTransaction[]
  currentVehicle     TransportVehicle?   @relation("current_driver_vehicle", fields: [current_vehicle_id], references: [vehicle_id])
  currentPartner     Partner?            @relation("current_partner_drivers", fields: [partner_id], references: [partner_id])
  transportOwner     VehicleOwner?       @relation("transport_owner_drivers", fields: [transport_owner_id], references: [owner_id], onDelete: Restrict)
  user               User                @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  assignedEnquiries  Enquiry[]           @relation("enquiry_assigned_driver")
  reservations       Reservation[]
  trips              Trip[]
  vehicleAssignments VehicleAssignment[] @relation("assigned_driver")
  vehicleHires       VehicleHire[]

  @@index([driver_code], map: "idx_drivers_code")
  @@index([user_id], map: "idx_drivers_user")
  @@index([partner_id], map: "idx_drivers_partner")
  @@index([transport_owner_id], map: "idx_drivers_transport_owner")
  @@index([license_number], map: "idx_drivers_license")
  @@index([status], map: "idx_drivers_status")
  @@index([mobile], map: "idx_drivers_mobile")
  @@index([alternate_mobile], map: "idx_drivers_alt_mobile")
  @@index([city], map: "idx_drivers_city")
  @@index([state], map: "idx_drivers_state")
  @@index([current_vehicle_id], map: "idx_drivers_current_vehicle")
  @@map("drivers")
}

model DriverTransaction {
  transaction_id   Int       @id @default(autoincrement())
  driver_id        Int
  transaction_type String
  amount           Float
  balance_before   Float
  balance_after    Float
  description      String?
  reference_type   String?
  reference_id     Int?
  payment_mode     String?
  transaction_date DateTime? @default(now())
  recorded_by      Int?
  notes            String?
  created_at       DateTime? @default(now())
  driver           Driver    @relation(fields: [driver_id], references: [driver_id], onDelete: Cascade)

  @@index([driver_id], map: "idx_driver_tx_driver")
  @@index([transaction_type], map: "idx_driver_tx_type")
  @@index([transaction_date], map: "idx_driver_tx_date")
  @@map("driver_transactions")
}

model DriverTimeline {
  event_id       Int       @id @default(autoincrement())
  driver_id      Int
  event_type     String
  description    String
  reference_type String?
  reference_id   Int?
  metadata       String?
  created_at     DateTime? @default(now())
  driver         Driver    @relation(fields: [driver_id], references: [driver_id], onDelete: Cascade)

  @@index([driver_id], map: "idx_driver_timeline_driver")
  @@index([event_type], map: "idx_driver_timeline_event")
  @@index([created_at], map: "idx_driver_timeline_date")
  @@map("driver_timeline")
}

model VehicleOwner {
  owner_id          Int                  @id @default(autoincrement())
  owner_code        String?              @unique
  owner_name        String
  company_name      String?
  email             String?
  mobile            String
  alternate_mobile  String?
  city              String?
  state             String?              @default("Bihar")
  gst_number        String?
  pan_number        String?
  bank_account      String?
  bank_ifsc         String?
  bank_name         String?
  upi_id            String?
  address           String?
  status            String?              @default("active")
  owner_type        String?              @default("TRANSPORT_COMPANY")
  notes             String?
  is_active         Boolean?             @default(true)
  created_at        DateTime?            @default(now())
  updated_at        DateTime?            @default(now())
  deleted_at        DateTime?
  partner_link      Int?                 @unique
  bookings          Booking[]
  drivers           Driver[]             @relation("transport_owner_drivers")
  assignedEnquiries Enquiry[]            @relation("enquiry_assigned_owner")
  applications      PartnerApplication[] @relation("vehicle_owner_applications")
  vehicles          TransportVehicle[]   @relation("vehicle_owner")
  trips             Trip[]
  vehicleHires      VehicleHire[]
  linkedPartner     Partner?             @relation("vehicle_owner_link", fields: [partner_link], references: [partner_id])

  @@index([owner_code], map: "idx_vehicle_owner_code")
  @@index([mobile], map: "idx_vehicle_owner_mobile")
  @@index([status], map: "idx_vehicle_owner_status")
  @@index([city], map: "idx_vehicle_owner_city")
  @@index([state], map: "idx_vehicle_owner_state")
  @@index([is_active], map: "idx_vehicle_owner_active")
  @@index([owner_type], map: "idx_vehicle_owner_type")
  @@index([partner_link], map: "idx_vehicle_owner_partner_link")
  @@map("vehicle_owners")
}

model TransportVehicle {
  vehicle_id             Int                 @id @default(autoincrement())
  driver_id              Int?
  vehicle_number         String              @unique
  vehicle_type           String
  vehicle_name           String?
  capacity_kg            Float?
  capacity_volume        Float?
  vehicle_make           String?
  vehicle_model          String?
  manufacturing_year     Int?
  registration_date      String?
  insurance_number       String?
  insurance_expiry       String?
  permit_number          String?
  permit_expiry          String?
  pollution_certificate  String?
  pollution_expiry       String?
  is_available           Boolean?            @default(true)
  is_verified            Boolean?            @default(false)
  current_status         String?             @default("available")
  base_location          String?
  hourly_rate            Float?
  per_km_rate            Float?
  created_at             DateTime?           @default(now())
  updated_at             DateTime?           @default(now())
  body_type              String?
  owner_id               Int?
  partner_id             Int?
  vehicle_code           String?             @unique
  tax_number             String?
  tax_expiry             String?
  fitness_number         String?
  fitness_expiry         String?
  national_permit_number String?
  national_permit_expiry String?
  bookingAssignments     BookingAssignment[]
  bookings               Booking[]
  deliveries             Delivery[]
  driver                 Driver?             @relation("current_driver_vehicle")
  assignedEnquiries      Enquiry[]           @relation("enquiry_assigned_vehicle")
  requestedEnquiries     Enquiry[]           @relation("enquiry_requested_vehicle")
  reservations           Reservation[]
  owner                  VehicleOwner?       @relation("vehicle_owner", fields: [owner_id], references: [owner_id])
  sourcePartner          Partner?            @relation("sourced_vehicles", fields: [partner_id], references: [partner_id])
  trips                  Trip[]
  vehicleAssignments     VehicleAssignment[]
  vehicleHires           VehicleHire[]

  @@index([driver_id], map: "idx_vehicles_driver")
  @@index([owner_id], map: "idx_vehicles_owner")
  @@index([partner_id], map: "idx_vehicles_partner")
  @@index([vehicle_number], map: "idx_vehicles_number")
  @@index([vehicle_type], map: "idx_vehicles_type")
  @@index([is_available], map: "idx_vehicles_available")
  @@index([fitness_expiry], map: "idx_vehicles_fitness_expiry")
  @@index([insurance_expiry], map: "idx_vehicles_insurance_expiry")
  @@index([permit_expiry], map: "idx_vehicles_permit_expiry")
  @@map("transport_vehicles")
}

model Booking {
  booking_id                  Int                          @id @default(autoincrement())
  booking_reference           String?                      @unique
  booking_number              String                       @unique
  user_id                     Int
  driver_id                   Int?
  vehicle_id                  Int?
  pickup_location             String
  pickup_address              String?
  pickup_city                 String
  pickup_state                String?                      @default("Bihar")
  pickup_pincode              String?
  pickup_date                 String
  pickup_time                 String
  drop_location               String
  drop_address                String?
  drop_city                   String
  drop_state                  String?                      @default("Bihar")
  drop_pincode                String?
  goods_description           String
  goods_type                  String?
  goods_weight_kg             Float?
  goods_volume                Float?
  number_of_items             Int?                         @default(1)
  fragile                     Boolean?                     @default(false)
  vehicle_type_required       String
  estimated_distance_km       Float?
  estimated_price             Float?
  final_price                 Float?
  status                      String?                      @default("pending")
  created_at                  DateTime?                    @default(now())
  updated_at                  DateTime?                    @default(now())
  confirmed_at                DateTime?
  driver_assigned_at          DateTime?
  pickup_completed_at         DateTime?
  delivered_at                DateTime?
  quote_accepted_at           DateTime?
  quote_rejected_at           DateTime?
  quote_remarks               String?
  quote_sent_at               DateTime?
  quote_status                String?                      @default("PENDING")
  quote_valid_until           DateTime?
  confirmation_source         String?
  archived_at                 DateTime?
  commission_amount           Float?                       @default(0)
  commission_percentage       Float?                       @default(0)
  commission_type             String?                      @default("percentage")
  driver_name_snapshot        String?
  driver_payout               Float?
  mobile_snapshot             String?
  owner_settlement_amount     Float?
  partner_id                  Int?
  partner_name_snapshot       String?
  settlement_id               Int?
  settlement_status           String?                      @default("pending")
  truck_number_snapshot       String?
  vehicle_owner_id            Int?
  quantity_unit               String?
  weight_unit                 String?
  special_instructions        String?
  bookingAssignments          BookingAssignment[]
  bookingEvents               BookingEvent[]
  booking_quotation_snapshots booking_quotation_snapshots?
  driver                      Driver?                      @relation(fields: [driver_id], references: [driver_id])
  partner                     Partner?                     @relation(fields: [partner_id], references: [partner_id])
  bookingSettlement           Settlement?                  @relation(fields: [settlement_id], references: [settlement_id])
  user                        User                         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  vehicle                     TransportVehicle?            @relation(fields: [vehicle_id], references: [vehicle_id])
  vehicleOwner                VehicleOwner?                @relation(fields: [vehicle_owner_id], references: [owner_id])
  commissionRecords           CommissionRecord[]
  delivery                    Delivery?
  enquiry                     Enquiry?                     @relation("enquiry_booking")
  financialTransactions       FinancialTransaction[]
  invoices                    Invoice?
  ledgerEntries               PartnerLedger[]              @relation("ledger_entries")
  reservations                Reservation[]
  tripAdvances                TripAdvance[]
  tripFinancial               TripFinancial?
  tripSettlements             TripSettlement[]
  trips                       Trip[]
  vehicleHires                VehicleHire[]

  @@index([user_id], map: "idx_bookings_user")
  @@index([driver_id], map: "idx_bookings_driver")
  @@index([vehicle_id], map: "idx_bookings_vehicle")
  @@index([partner_id], map: "idx_bookings_partner")
  @@index([vehicle_owner_id], map: "idx_bookings_vehicle_owner")
  @@index([booking_reference], map: "idx_bookings_reference")
  @@index([status], map: "idx_bookings_status")
  @@index([pickup_date], map: "idx_bookings_date")
  @@index([booking_number], map: "idx_bookings_booking_number")
  @@index([settlement_id], map: "idx_bookings_settlement")
  @@map("bookings")
}

model Delivery {
  delivery_id             Int               @id @default(autoincrement())
  booking_id              Int               @unique
  driver_id               Int?
  vehicle_id              Int?
  current_status          String?           @default("booking_confirmed")
  status_description      String?
  current_latitude        Float?
  current_longitude       Float?
  last_location_update    DateTime?
  estimated_pickup_time   DateTime?
  actual_pickup_time      DateTime?
  estimated_delivery_time DateTime?
  actual_delivery_time    DateTime?
  delivery_otp            String?
  otp_verified            Boolean?          @default(false)
  delivery_proof_image    String?
  delivery_notes          String?
  recipient_name          String?
  created_at              DateTime?         @default(now())
  updated_at              DateTime?         @default(now())
  booking                 Booking           @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  driver                  Driver?           @relation(fields: [driver_id], references: [driver_id])
  vehicle                 TransportVehicle? @relation(fields: [vehicle_id], references: [vehicle_id])

  @@index([booking_id], map: "idx_deliveries_booking")
  @@index([driver_id], map: "idx_deliveries_driver")
  @@index([vehicle_id], map: "idx_deliveries_vehicle")
  @@index([current_status], map: "idx_deliveries_status")
  @@map("deliveries")
}

model Admin {
  admin_id                                          Int                  @id @default(autoincrement())
  username                                          String               @unique
  email                                             String               @unique
  password_hash                                     String
  full_name                                         String
  phone                                             String?
  role                                              String?              @default("admin")
  is_active                                         Boolean?             @default(true)
  created_at                                        DateTime?            @default(now())
  updated_at                                        DateTime?            @default(now())
  bookingAssignments                                BookingAssignment[]  @relation("assigned_by_admin")
  enquiryQuotes                                     Enquiry[]            @relation("enquiry_quoted_by")
  quotation_versions                                quotation_versions[]
  quotations_quotations_quoted_by_admin_idToadmins  quotations[]         @relation("quotations_quoted_by_admin_idToadmins")
  quotations_quotations_sent_by_admin_idToadmins    quotations[]         @relation("quotations_sent_by_admin_idToadmins")
  quotations_quotations_updated_by_admin_idToadmins quotations[]         @relation("quotations_updated_by_admin_idToadmins")

  @@map("admins")
}

model BookingEvent {
  booking_event_id Int       @id @default(autoincrement())
  booking_id       Int
  event_type       String
  event_payload    String?
  created_at       DateTime? @default(now())
  booking          Booking   @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)

  @@index([booking_id], map: "idx_booking_events_booking_id")
  @@index([event_type], map: "idx_booking_events_event_type")
  @@index([created_at], map: "idx_booking_events_created_at")
  @@map("booking_events")
}

model BookingAssignment {
  booking_assignment_id Int               @id @default(autoincrement())
  booking_id            Int
  assigned_driver_id    Int?
  assigned_vehicle_id   Int?
  assigned_by_admin_id  Int?
  assignment_status     String?           @default("active")
  created_at            DateTime?         @default(now())
  assignedByAdmin       Admin?            @relation("assigned_by_admin", fields: [assigned_by_admin_id], references: [admin_id])
  assignedDriver        Driver?           @relation("assigned_driver", fields: [assigned_driver_id], references: [driver_id])
  assignedVehicle       TransportVehicle? @relation(fields: [assigned_vehicle_id], references: [vehicle_id])
  booking               Booking           @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)

  @@index([booking_id], map: "idx_booking_assignments_booking_id")
  @@index([assigned_driver_id], map: "idx_booking_assignments_driver_id")
  @@index([assigned_vehicle_id], map: "idx_booking_assignments_vehicle_id")
  @@index([created_at], map: "idx_booking_assignments_created_at")
  @@map("booking_assignments")
}

model Partner {
  partner_id            Int                  @id @default(autoincrement())
  partner_code          String?              @unique
  partner_name          String
  owner_name            String
  company_name          String?
  email                 String?
  mobile                String
  alternate_mobile      String?
  city                  String?
  state                 String?              @default("Bihar")
  gst_number            String?
  pan_number            String?
  bank_account          String?
  bank_ifsc             String?
  bank_name             String?
  upi_id                String?
  address               String?
  status                PartnerStatus        @default(active)
  notes                 String?
  available_capacity    String?
  network_locations     String?
  commission_percentage Float?               @default(10)
  commission_type       String?              @default("percentage")
  fixed_commission      Float?               @default(0)
  is_active             Boolean?             @default(true)
  created_at            DateTime?            @default(now())
  updated_at            DateTime?            @default(now())
  deleted_at            DateTime?
  partner_capability    String?              @default("PARTNER_ONLY")
  bookings              Booking[]
  driverAssignments     DriverAssignment[]   @relation("partner_assignments")
  drivers               Driver[]             @relation("current_partner_drivers")
  assignedEnquiries     Enquiry[]            @relation("enquiry_assigned_partner")
  applications          PartnerApplication[]
  documents             PartnerDocument[]
  ledgerEntries         PartnerLedger[]
  payments              PartnerPayment[]
  settlements           Settlement[]
  sourcedVehicles       TransportVehicle[]   @relation("sourced_vehicles")
  linkedVehicleOwner    VehicleOwner?        @relation("vehicle_owner_link")

  @@index([partner_code], map: "idx_partner_code")
  @@index([mobile], map: "idx_partner_mobile")
  @@index([status], map: "idx_partner_status")
  @@index([city], map: "idx_partner_city")
  @@index([state], map: "idx_partner_state")
  @@index([is_active], map: "idx_partner_active")
  @@index([partner_capability], map: "idx_partner_capability")
  @@map("partners")
}

model DriverAssignment {
  assignment_id Int       @id @default(autoincrement())
  driver_id     Int
  partner_id    Int
  assigned_by   Int?
  assigned_at   DateTime? @default(now())
  unassigned_at DateTime?
  status        String?   @default("active")
  notes         String?
  created_at    DateTime? @default(now())
  driver        Driver    @relation("assigned_driver_history", fields: [driver_id], references: [driver_id], onDelete: Cascade)
  partner       Partner   @relation("partner_assignments", fields: [partner_id], references: [partner_id], onDelete: Cascade)

  @@index([driver_id], map: "idx_drv_assign_driver")
  @@index([partner_id], map: "idx_drv_assign_partner")
  @@index([status], map: "idx_drv_assign_status")
  @@map("driver_assignments")
}

model VehicleAssignment {
  assignment_id Int              @id @default(autoincrement())
  vehicle_id    Int
  driver_id     Int
  assigned_by   Int?
  assigned_at   DateTime?        @default(now())
  unassigned_at DateTime?
  status        String?          @default("active")
  notes         String?
  created_at    DateTime?        @default(now())
  driver        Driver           @relation("assigned_driver", fields: [driver_id], references: [driver_id], onDelete: Cascade)
  vehicle       TransportVehicle @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade)

  @@index([vehicle_id], map: "idx_veh_assign_vehicle")
  @@index([driver_id], map: "idx_veh_assign_driver")
  @@index([status], map: "idx_veh_assign_status")
  @@map("vehicle_assignments")
}

model PartnerLedger {
  ledger_id        Int                   @id @default(autoincrement())
  partner_id       Int
  booking_id       Int?
  transaction_id   String                @unique
  transaction_type LedgerTransactionType
  date             DateTime?             @default(now())
  description      String?
  debit            Float?                @default(0)
  credit           Float?                @default(0)
  running_balance  Float                 @default(0)
  payment_mode     String?
  remarks          String?
  reference_number String?
  created_by       Int?
  is_reversal      Boolean?              @default(false)
  reversal_of      String?
  created_at       DateTime?             @default(now())
  booking          Booking?              @relation("ledger_entries", fields: [booking_id], references: [booking_id])
  partner          Partner               @relation(fields: [partner_id], references: [partner_id], onDelete: Cascade)

  @@index([partner_id], map: "idx_ledger_partner")
  @@index([booking_id], map: "idx_ledger_booking")
  @@index([transaction_type], map: "idx_ledger_type")
  @@index([date], map: "idx_ledger_date")
  @@index([transaction_id], map: "idx_ledger_txn_id")
  @@index([created_at], map: "idx_ledger_created")
  @@map("partner_ledger")
}

model PartnerPayment {
  payment_id       Int         @id @default(autoincrement())
  payment_number   String      @unique
  partner_id       Int
  amount           Float
  payment_method   String
  reference_number String?
  date             DateTime?   @default(now())
  created_by       Int?
  status           String?     @default("pending")
  remarks          String?
  settlement_id    Int?
  created_at       DateTime?   @default(now())
  updated_at       DateTime?   @default(now())
  partner          Partner     @relation(fields: [partner_id], references: [partner_id], onDelete: Cascade)
  settlement       Settlement? @relation(fields: [settlement_id], references: [settlement_id])

  @@index([partner_id], map: "idx_payment_partner")
  @@index([payment_number], map: "idx_payment_number")
  @@index([status], map: "idx_payment_status")
  @@index([date], map: "idx_payment_date")
  @@map("partner_payments")
}

model Settlement {
  settlement_id     Int              @id @default(autoincrement())
  settlement_number String           @unique
  partner_id        Int
  month             Int
  year              Int
  total_bookings    Int?             @default(0)
  gross_revenue     Float?           @default(0)
  commission        Float?           @default(0)
  fuel_advance      Float?           @default(0)
