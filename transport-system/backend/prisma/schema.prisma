  customer_name                                 String
  customer_mobile                               String
  customer_email                                String?
  session_key                                   String?
  pickup_location                               String
  pickup_address                                String?
  pickup_latitude                               Float?
  pickup_longitude                              Float?
  drop_location                                 String
  drop_address                                  String?
  drop_latitude                                 Float?
  drop_longitude                                Float?
  distance_km                                   Float?
  requested_vehicle_id                          Int?
  requested_vehicle_name                        String?
  assigned_vehicle_id                           Int?
  assigned_driver_id                            Int?
  assigned_partner_id                           Int?
  assigned_owner_id                             Int?
  assigned_vehicle_number                       String?
  assigned_vehicle_type                         String?
  assigned_driver_name                          String?
  driver_assigned_at                            DateTime?
  vehicle_assigned_at                           DateTime?
  material                                      String?
  quantity                                      Float?
  quantity_unit                                 String?
  weight                                        Float?
  weight_unit                                   String?
  goods_category                                String?
  fragile                                       Boolean            @default(false)
  special_instructions                          String?
  pickup_date                                   DateTime
  pickup_time                                   String
  estimated_price_min                           Float?
  estimated_price_max                           Float?
  final_quoted_price                            Float?
  price_status                                  EnquiryPriceStatus @default(NOT_QUOTED)
  quote_remarks                                 String?
  quoted_by_admin_id                            Int?
  quoted_at                                     DateTime?
  status                                        EnquiryStatus      @default(ENQUIRY_SUBMITTED)
  accepted_at                                   DateTime?
  rejected_at                                   DateTime?
  cancelled_at                                  DateTime?
  cancellation_reason                           String?
  confirmed_at                                  DateTime?
  started_at                                    DateTime?
  completed_at                                  DateTime?
  booking_id                                    Int?               @unique
  created_at                                    DateTime           @default(now())
  updated_at                                    DateTime           @default(now()) @updatedAt
  quotation_id                                  Int?               @unique
  assignedDriver                                Driver?            @relation("enquiry_assigned_driver", fields: [assigned_driver_id], references: [driver_id])
  assignedOwner                                 VehicleOwner?      @relation("enquiry_assigned_owner", fields: [assigned_owner_id], references: [owner_id])
  assignedPartner                               Partner?           @relation("enquiry_assigned_partner", fields: [assigned_partner_id], references: [partner_id])
  assignedVehicle                               TransportVehicle?  @relation("enquiry_assigned_vehicle", fields: [assigned_vehicle_id], references: [vehicle_id])
  booking                                       Booking?           @relation("enquiry_booking", fields: [booking_id], references: [booking_id])
  customer                                      User?              @relation("enquiry_customer", fields: [customer_id], references: [user_id])
  quotations_enquiries_quotation_idToquotations quotations?        @relation("enquiries_quotation_idToquotations", fields: [quotation_id], references: [quotation_id])
  quotedByAdmin                                 Admin?             @relation("enquiry_quoted_by", fields: [quoted_by_admin_id], references: [admin_id])
  requestedVehicle                              TransportVehicle?  @relation("enquiry_requested_vehicle", fields: [requested_vehicle_id], references: [vehicle_id])
  events                                        EnquiryEvent[]
  quotations_quotations_enquiry_idToenquiries   quotations?        @relation("quotations_enquiry_idToenquiries")
  reservations                                  Reservation[]

  @@index([customer_id], map: "idx_enquiries_customer")
  @@index([booking_id], map: "idx_enquiries_booking")
  @@index([customer_mobile], map: "idx_enquiries_mobile")
  @@index([session_key], map: "idx_enquiries_session")
  @@index([status], map: "idx_enquiries_status")
  @@index([price_status], map: "idx_enquiries_price_status")
  @@index([assigned_driver_id], map: "idx_enquiries_driver")
  @@index([assigned_vehicle_id], map: "idx_enquiries_vehicle")
  @@index([assigned_partner_id], map: "idx_enquiries_partner")
  @@index([pickup_date], map: "idx_enquiries_pickup_date")
  @@index([created_at], map: "idx_enquiries_created")
  @@map("enquiries")
}

model EnquiryEvent {
  enquiry_event_id Int              @id @default(autoincrement())
  enquiry_id       Int
  event_type       EnquiryEventType
  actor_type       EnquiryActorType @default(SYSTEM)
  actor_id         Int?
  actor_name       String?
  message          String
  metadata         Json?
  customer_visible Boolean          @default(true)
  created_at       DateTime         @default(now())
  enquiry          Enquiry          @relation(fields: [enquiry_id], references: [enquiry_id], onDelete: Cascade)

  @@index([event_type], map: "idx_enquiry_events_type")
  @@index([created_at], map: "idx_enquiry_events_created")
  @@index([enquiry_id, created_at], map: "idx_enquiry_events_enquiry")
  @@map("enquiry_events")
}

/// The dispatch act for one consignment. One row per trip, ever.
model TripDispatch {
  dispatch_id          Int            @id @default(autoincrement())
  trip_id              Int            @unique
  dispatched_at        DateTime
  dispatch_origin      String         @default("ADMIN")
  lr_gr_number         String?
  lr_gr_document_id    Int?
  lr_gr_remarks        String?
  delivery_number      String?
  consignee_name       String?
  consignee_contact    String?
  consignee_address    String?
  value_of_goods       Float?
  actual_quantity      Float?
  actual_quantity_unit String?
  actual_weight_kg     Float?
  invoice_id           Int?           @unique
  eway_bill_id         Int?           @unique
  insurance_id         Int?           @unique
  pod_required         Boolean        @default(false)
  status               String         @default("DISPATCHED")
  created_by           Int?
  created_at           DateTime?      @default(now())
  updated_at           DateTime?      @default(now())
  ewayBill             EwayBill?      @relation(fields: [eway_bill_id], references: [eway_bill_id], onUpdate: NoAction)
  insurance            TripInsurance? @relation(fields: [insurance_id], references: [insurance_id], onUpdate: NoAction)
  invoices             Invoice?       @relation(fields: [invoice_id], references: [invoice_id], onUpdate: NoAction)
  lrGrDoc              TripDocument?  @relation("dispatch_lr_gr", fields: [lr_gr_document_id], references: [document_id], onUpdate: NoAction)
  trip                 Trip           @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([dispatched_at], map: "idx_trip_dispatch_at")
  @@index([trip_id], map: "idx_trip_dispatch_trip")
  @@map("trip_dispatches")
}

/// One internal e-way bill record per trip.
/// This is an INTERNAL RECORD ONLY — no government/NIC API integration exists.
model EwayBill {
  eway_bill_id            Int           @id @default(autoincrement())
  trip_id                 Int           @unique
  eway_bill_number        String?
  eway_bill_date          DateTime?
  expiry_at               DateTime?
  internal_status         String        @default("RECORDED")
  document_id             Int?
  remarks                 String?
  current_vehicle_number  String?
  previous_vehicle_number String?
  vehicle_update_required Boolean       @default(false)
  created_by              Int?
  created_at              DateTime?     @default(now())
  updated_at              DateTime?     @default(now())
  document                TripDocument? @relation("eway_bill_document", fields: [document_id], references: [document_id], onUpdate: NoAction)
  trip                    Trip          @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade, onUpdate: NoAction)
  dispatch                TripDispatch?

  @@index([eway_bill_number], map: "idx_eway_bill_number")
  @@index([trip_id], map: "idx_eway_bill_trip")
  @@map("eway_bills")
}

model TripInsurance {
  insurance_id      Int           @id @default(autoincrement())
  trip_id           Int           @unique
  insured           Boolean       @default(false)
  insurance_company String?
  policy_number     String?
  sum_insured       Float?
  goods_value       Float?
  claim_contact     String?
  valid_from        DateTime?
  valid_to          DateTime?
  document_id       Int?
  status            String        @default("NOT_APPLICABLE")
  remarks           String?
  created_by        Int?
  created_at        DateTime?     @default(now())
  updated_at        DateTime?     @default(now())
  dispatch          TripDispatch?
  document          TripDocument? @relation("insurance_document", fields: [document_id], references: [document_id], onUpdate: NoAction)
  trip              Trip          @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([trip_id], map: "idx_trip_insurance_trip")
  @@map("trip_insurances")
}

model booking_quotation_snapshots {
  snapshot_id              Int                          @id @default(autoincrement())
  booking_id               Int                          @unique
  quotation_id             Int?
  rate_type                QuotationRateType
  rate                     Float?
  freight                  Float
  total_freight            Float
  gst_type                 QuotationGstType?
  gst_percentage           Float?
  gst_amount               Float?
  total_additional_charges Float
  additional_charges_tax   Float
  total_billing_amount     Float
  validity_days            Int?
  payment_schedule_type    QuotationPaymentScheduleType
  schedule_total           Float
  schedule_remaining       Float
  captured_at              DateTime                     @default(now())
  bookings                 Booking                      @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  quotations               quotations?                  @relation(fields: [quotation_id], references: [quotation_id])

  @@index([quotation_id], map: "idx_booking_quotation_snapshot_quotation")
}

model quotation_charges {
  charge_id     Int        @id @default(autoincrement())
  quotation_id  Int
  charges_name  String
  rate          Float
  quantity      Float
  quantity_unit String?
  total         Float
  sort_order    Int        @default(0)
  created_at    DateTime   @default(now())
  updated_at    DateTime
  quotations    quotations @relation(fields: [quotation_id], references: [quotation_id], onDelete: Cascade)

  @@index([quotation_id], map: "idx_quotation_charges_quotation")
}

model quotation_milestones {
  milestone_id      Int                          @id @default(autoincrement())
  quotation_id      Int
  due_point         String
  amount_type       QuotationMilestoneAmountType @default(FIXED)
  amount_value      Float
  computed_amount   Float
  remaining_balance Float
  sort_order        Int                          @default(0)
  created_at        DateTime                     @default(now())
  updated_at        DateTime
  quotations        quotations                   @relation(fields: [quotation_id], references: [quotation_id], onDelete: Cascade)

  @@index([quotation_id], map: "idx_quotation_milestones_quotation")
}

model quotation_versions {
  version_id                       Int                          @id @default(autoincrement())
  quotation_id                     Int
  version_number                   Int
  rate_type                        QuotationRateType
  rate                             Float?
  freight                          Float
  total_freight                    Float
  gst_type                         QuotationGstType?
  gst_percentage                   Float?
  gst_amount                       Float?
  total_additional_charges         Float
  additional_charges_tax           Float
  total_billing_amount             Float
  validity_days                    Int?
  payment_schedule_type            QuotationPaymentScheduleType
  booking_amount                   Float?
  advance_after_loading_percentage Float?
  schedule_total                   Float
  schedule_remaining               Float
  remarks                          String?
  changed_by_admin_id              Int?
  change_reason                    String?
  created_at                       DateTime                     @default(now())
  admins                           Admin?                       @relation(fields: [changed_by_admin_id], references: [admin_id])
  quotations                       quotations                   @relation(fields: [quotation_id], references: [quotation_id], onDelete: Cascade)

  @@unique([quotation_id, version_number])
  @@index([quotation_id], map: "idx_quotation_versions_quotation")
}

model quotations {
  quotation_id                                  Int                           @id @default(autoincrement())
  enquiry_id                                    Int                           @unique
  quotation_number                              String                        @unique
  rate_type                                     QuotationRateType             @default(FIXED)
  rate                                          Float?
  freight                                       Float
  total_freight                                 Float
  gst_type                                      QuotationGstType?
  gst_percentage                                Float?
  gst_amount                                    Float?                        @default(0)
  total_additional_charges                      Float                         @default(0)
  additional_charges_tax                        Float                         @default(0)
  total_billing_amount                          Float                         @default(0)
  validity_days                                 Int?
  valid_until                                   DateTime?
  payment_schedule_type                         QuotationPaymentScheduleType  @default(FULL_PAYMENT_IN_ADVANCE)
  booking_amount                                Float?
  advance_after_loading_percentage              Float?
  schedule_total                                Float                         @default(0)
  schedule_remaining                            Float                         @default(0)
  remarks                                       String?
  status                                        QuotationStatus               @default(DRAFT)
  quoted_at                                     DateTime?
  sent_at                                       DateTime?
  confirmed_at                                  DateTime?
  confirmed_total_billing_amount                Float?
  quoted_by_admin_id                            Int?
  sent_by_admin_id                              Int?
  updated_by_admin_id                           Int?
  created_at                                    DateTime                      @default(now())
  updated_at                                    DateTime
  booking_quotation_snapshots                   booking_quotation_snapshots[]
  enquiries_enquiries_quotation_idToquotations  Enquiry?                      @relation("enquiries_quotation_idToquotations")
  quotation_charges                             quotation_charges[]
  quotation_milestones                          quotation_milestones[]
  quotation_versions                            quotation_versions[]
  enquiries_quotations_enquiry_idToenquiries    Enquiry                       @relation("quotations_enquiry_idToenquiries", fields: [enquiry_id], references: [enquiry_id], onDelete: Cascade)
  admins_quotations_quoted_by_admin_idToadmins  Admin?                        @relation("quotations_quoted_by_admin_idToadmins", fields: [quoted_by_admin_id], references: [admin_id])
  admins_quotations_sent_by_admin_idToadmins    Admin?                        @relation("quotations_sent_by_admin_idToadmins", fields: [sent_by_admin_id], references: [admin_id])
  admins_quotations_updated_by_admin_idToadmins Admin?                        @relation("quotations_updated_by_admin_idToadmins", fields: [updated_by_admin_id], references: [admin_id])

  @@index([enquiry_id], map: "idx_quotations_enquiry")
  @@index([quotation_number], map: "idx_quotations_number")
  @@index([status], map: "idx_quotations_status")
}

model trip_incidents {
  incident_id          Int                    @id @default(autoincrement())
  trip_id              Int
  incident_type        String
  description          String?
  location             String?
  vehicle_can_continue Boolean?
  expected_repair_at   DateTime?
  photos               Json?
  resolution           String                 @default("ONGOING")
  resolution_remarks   String?
  resolved_at          DateTime?
  reported_at          DateTime               @default(now())
  created_by           Int?
  created_at           DateTime?              @default(now())
  updated_at           DateTime?              @default(now())
  trips                Trip                   @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade, onUpdate: NoAction)
  trip_vehicle_changes trip_vehicle_changes[]

  @@index([trip_id, reported_at], map: "idx_incident_trip_reported")
  @@index([incident_type], map: "idx_incident_type")
}

model trip_vehicle_changes {
  change_id          Int             @id @default(autoincrement())
  trip_id            Int
  sequence           Int             @default(1)
  old_vehicle_id     Int?
  old_vehicle_number String?
  new_vehicle_id     Int?
  new_vehicle_number String?
  old_driver_id      Int?
  old_driver_name    String?
  new_driver_id      Int?
  new_driver_name    String?
  reason             String
  remarks            String?
  location           String?
  occurred_at        DateTime        @default(now())
  proof_document_id  Int?
  incident_id        Int?
  created_by         Int?
  created_at         DateTime?       @default(now())
  trip_incidents     trip_incidents? @relation(fields: [incident_id], references: [incident_id], onUpdate: NoAction)
  trip_documents     TripDocument?   @relation(fields: [proof_document_id], references: [document_id], onUpdate: NoAction)
  trips              Trip            @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([trip_id, sequence], map: "idx_vehicle_change_trip_seq")
}

