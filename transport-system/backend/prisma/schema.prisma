// --- Transport Partners (Network Partners) ---
model Partner {
  partner_id            Int           @id @default(autoincrement())
  partner_code          String?       @unique // Auto-generated: PRT000001 (nullable for migration)
  partner_name          String
  owner_name            String
  company_name          String?
  email                 String?
  mobile                String
  alternate_mobile      String?
  city                  String?
  state                 String?       @default("Bihar")
  gst_number            String?
  pan_number            String?
  bank_account          String?
  bank_ifsc             String?
  bank_name             String?
  upi_id                String?
  address               String?
  status                PartnerStatus @default(active)
  notes                 String?
  // Network/capacity information
