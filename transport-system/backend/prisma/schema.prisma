// ============================================================
// Bihar Transport Begusarai - Prisma Schema (Phase 3)
// Target Database: PostgreSQL
// Includes Transport Partner Module (Partners, Trucks, Ledger,
// Payments, Settlements, Documents, Driver Assignments)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  customer
  driver
  partner
  admin
}

enum BookingStatus {
  pending
  confirmed
  driver_assigned
  pickup_completed
  in_transit
  delivered
  cancelled
  completed
}

enum DeliveryStatus {
  booking_confirmed
  driver_assigned
  pickup_in_progress
  pickup_completed
  in_transit
  out_for_delivery
  delivered
}

enum AdminRole {
  super_admin
  admin
  operator
}

enum AssignmentStatus {
  active
  // Other statuses as needed in future phases
}

// Quote workflow states (enterprise quote → approval → confirmation)
enum QuoteStatus {
  PENDING
  PREPARING
  DRIVER_RESERVED
  VEHICLE_RESERVED
  QUOTE_SENT
  WAITING_CUSTOMER_APPROVAL
  ACCEPTED
  REJECTED
  EXPIRED
}

// Reservation lifecycle (driver/vehicle held before customer approval)
enum ReservationStatus {
  ACTIVE
  CONVERTED
  RELEASED
  EXPIRED
}

// Invoice lifecycle (generated on delivery completion, not on quote accept)
enum InvoiceStatus {
  PENDING
  GENERATED
  PAID
  CANCELLED
}

// ============================================================
// ENQUIRY (PRE-BOOKING REQUEST) ENUMS
// ============================================================
// The Enquiry is the CUSTOMER-FACING INTAKE record that exists BEFORE any
// Booking/Trip exists. It captures what the customer asked for, then tracks
// the admin assignment + quotation + acceptance handshake.
//
// Lifecycle:
//   ENQUIRY_SUBMITTED → ADMIN_REVIEW → ASSIGNMENT_PENDING → VEHICLE_ASSIGNED
//   → DRIVER_ASSIGNED → QUOTE_READY → AWAITING_CUSTOMER_ACCEPTANCE
//   → CUSTOMER_ACCEPTED → CONFIRMED → IN_PROGRESS → COMPLETED
//
// Terminal states: CUSTOMER_REJECTED, CANCELLED
enum EnquiryStatus {
  ENQUIRY_SUBMITTED
  ADMIN_REVIEW
  ASSIGNMENT_PENDING
  VEHICLE_ASSIGNED
  DRIVER_ASSIGNED
  QUOTE_READY
  AWAITING_CUSTOMER_ACCEPTANCE
  CUSTOMER_ACCEPTED
  CUSTOMER_REJECTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Pricing stage of the enquiry. Kept separate from EnquiryStatus so the
// price can be re-quoted without losing the operational status history.
enum EnquiryPriceStatus {
  NOT_QUOTED
  ESTIMATED
  QUOTED
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

// Who performed an EnquiryEvent. Used for audit + the customer-facing
// activity feed ("Transport team reviewing", "You accepted the quote").
enum EnquiryActorType {
  CUSTOMER
  ADMIN
  DRIVER
  PARTNER
  SYSTEM
}

// Canonical EnquiryEvent types. Stored as TEXT (not a Prisma enum) so new
// event types can be added by migration without invalidating history rows.
enum EnquiryEventType {
  ENQUIRY_CREATED
  ADMIN_VIEWED
  STATUS_CHANGED
  VEHICLE_ASSIGNED
  DRIVER_ASSIGNED
  PARTNER_ASSIGNED
  REASSIGNED
  QUOTE_CREATED
  QUOTE_SENT
  QUOTE_UPDATED
  CUSTOMER_ACCEPTED
  CUSTOMER_REJECTED
  CUSTOMER_CANCELLED
  DRIVER_REASSIGNMENT_REQUESTED
  DRIVER_ISSUE_REPORTED
  BOOKING_CREATED
  TRIP_LINKED
  NOTE_ADDED
}

// ============================================================
// TRIP MANAGEMENT ENUMS
// ============================================================

enum TripSourceType {
  ONLINE_BOOKING
  OFFLINE_CLIENT
  DIRECT
}

enum TripStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
}

enum TripExpenseType {
  DRIVER
  DIESEL
  TOLL
  LOADING
  UNLOADING
  OWNER
  MAINTENANCE
  LABOUR
  DOCUMENTATION
  PARKING
  LOCAL_TRANSPORT
  CUSTOMER_RELATED
  COMMUNICATION
  OTHER
}

// Who paid for a trip expense.
// Only expenses paid_by = BIHAR_TRANSPORT reduce BT Net Profit.
// Owner-paid expenses (diesel, maintenance, toll, driver wages, etc.)
// are owner-side costs and must NOT appear as BT expenses.
enum ExpensePaidBy {
  BIHAR_TRANSPORT
  TRANSPORT_OWNER
}

enum TripPaymentType {
  ADVANCE
  PARTIAL
  FULL
  SETTLEMENT
  OTHER
}

// Trip payment category - distinguishes who the payment is from/for
enum TripPaymentCategory {
  CLIENT_PAYMENT
  OWNER_PAYMENT
  DRIVER_PAYMENT
}

// ============================================================
// TRIP FINANCIAL ENUMS
// ============================================================

enum TripFinancialStatus {
  DRAFT
  CALCULATED
  ADJUSTED
  SETTLED
  CLOSED
}

enum AdvanceType {
  DRIVER_ADVANCE
  FUEL_ADVANCE
  OWNER_ADVANCE
  OTHER
}

enum TransactionDirection {
  DEBIT
  CREDIT
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
  REFUNDED
}

enum FinancialTransactionType {
  CUSTOMER_PAYMENT
  CLIENT_PAYMENT
  DRIVER_ADVANCE
  FUEL_ADVANCE
  OWNER_ADVANCE
  DRIVER_SETTLEMENT
  OWNER_SETTLEMENT
  COMMISSION
  TRIP_EXPENSE
  EXPENSE_REIMBURSEMENT
  ADJUSTMENT
  REFUND
  REVERSAL
}

// Party types for transaction ledger
enum TransactionParty {
  BIHAR_TRANSPORT
  CUSTOMER
  CLIENT
  TRANSPORT_OWNER
  DRIVER
  VENDOR
  OTHER
}

// ============================================================
// PARTNER MODULE ENUMS
// ============================================================

enum PartnerStatus {
  active
  inactive
  suspended
}

enum TruckStatus {
  available
  on_trip
  maintenance
  off_road
}

enum LedgerTransactionType {
  booking_income
  commission
  fuel_advance
  driver_advance
  toll
  repair
  penalty
  bonus
  cash
  online_transfer
  other_expense
  partner_payable    // Amount Bihar Transport owes partner
  partner_receivable // Amount partner owes Bihar Transport
  settlement_payment // Payment made to partner
  settlement_receipt // Payment received from partner
}

enum SettlementStatus {
  pending
  paid
  partially_paid
  cancelled
  locked
}

enum PartnerDocumentType {
  gst
  pan
  aadhaar
  rc
  insurance
  bank_details
  other
}

// ============================================================
// TABLES
// ============================================================

// --- Users (Customers) ---
model User {
  user_id       Int       @id @default(autoincrement())
  first_name    String
  last_name     String
  email         String    @unique
  phone         String    @unique
  password_hash String
  address       String?
  city          String?
  state         String?   @default("Bihar")
  pincode       String?
  role          UserRole? @default(customer)
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @default(now())

// Relations
  drivers            Driver[]
  bookings           Booking[]
  partnerApplications PartnerApplication[]
  trips              Trip[]
  passwordResetTokens PasswordResetToken[]
  otpVerifications   OtpVerification[]
  // Pre-booking enquiries raised by this customer (enquiry intake stage).
  enquiries          Enquiry[]        @relation("enquiry_customer")

  @@index([email], name: "idx_users_email")
  @@index([phone], name: "idx_users_phone")
  @@index([role], name: "idx_users_role")
  @@map("users")
}

// --- Password Reset Tokens ---
model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @unique
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime? @default(now())

  // Relations
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id], name: "idx_password_reset_user")
  @@index([expires_at], name: "idx_password_reset_expires")
  @@map("password_reset_tokens")
}

// --- OTP Verification ---
// Stores hashed OTP records for phone-based customer authentication.
// OTPs are NEVER stored in plaintext — only the SHA-256 hash is persisted.
// Each OTP is single-use and invalidated after successful verification.
model OtpVerification {
  id           Int       @id @default(autoincrement())
  user_id      Int?                  // Linked to User when phone is found; nullable for pre-registration OTPs
  phone        String                // Normalized 10-digit Indian mobile number
  otp_hash     String                // SHA-256 hash of the OTP (never plaintext)
  expires_at   DateTime              // OTP validity window (~5 minutes)
  attempts     Int       @default(0) // Number of failed verification attempts
  max_attempts Int       @default(3) // Maximum allowed verification attempts before lockout
  verified_at  DateTime?             // Timestamp when OTP was successfully verified (null = unused)
  consumed     Boolean   @default(false) // Prevents OTP reuse after successful verification
  created_at   DateTime? @default(now())
  updated_at   DateTime? @default(now())

  // Relations
  user User? @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([phone], name: "idx_otp_phone")
  @@index([expires_at], name: "idx_otp_expires")
  @@index([created_at], name: "idx_otp_created")
  @@index([user_id], name: "idx_otp_user")
  @@map("otp_verifications")
}

// --- Drivers ---
model Driver {
  driver_id         Int       @id @default(autoincrement())
  driver_code       String?   @unique    // Auto-generated: DRV000001 (nullable for migration)
  user_id           Int
  driver_name       String
  mobile            String
  alternate_mobile  String?
  address           String?
  city              String?
  state             String?   @default("Bihar")
  pincode           String?
  partner_id        Int?                  // Current partner assignment (nullable for unassigned drivers)
  transport_owner_id Int?                  // OPTIONAL: Driver can exist without Transport Owner (Self-Owner path creates DRIVER_OWNER)
  license_number    String?
  license_expiry    String?
  license_class     String?   // Vehicle type / license class (e.g. HTV, LMV)
  joining_date      String?
  status            String?   @default("available") // available, on_trip, inactive
  profile_image     String?
  is_available      Boolean?  @default(true)
  is_verified       Boolean?  @default(false)
  rating            Float?    @default(0)
  total_deliveries  Int?      @default(0)
  total_advance     Float?    @default(0)  // Total advance given
  total_paid        Float?    @default(0)  // Total amount paid
  total_expenses    Float?    @default(0)  // Total expenses
  current_balance   Float?    @default(0)  // Running balance
  performance_rating Float?   @default(0)  // Partner's performance rating
  created_at        DateTime? @default(now())
  updated_at        DateTime? @default(now())

  // Relations
  user                 User                @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  currentPartner       Partner?            @relation("current_partner_drivers", fields: [partner_id], references: [partner_id], onDelete: SetNull)
  transportOwner       VehicleOwner?       @relation("transport_owner_drivers", fields: [transport_owner_id], references: [owner_id], onDelete: Restrict)
  currentVehicle       TransportVehicle?   @relation("current_driver_vehicle", fields: [current_vehicle_id], references: [vehicle_id], onDelete: SetNull)
  bookings             Booking[]
  deliveries           Delivery[]
  bookingAssignments   BookingAssignment[] @relation("assigned_driver")
  transactions         DriverTransaction[]
  timelineEvents       DriverTimeline[]
  driverAssignments    DriverAssignment[]  @relation("assigned_driver_history")
// Relations
  reservations         Reservation[]
  vehicleAssignments   VehicleAssignment[] @relation("assigned_driver")
  trips                Trip[]
  // Enquiries this driver is ASSIGNED to via admin assignment.
  // NOTE: driver.mobile is NEVER exposed through enquiry customer DTOs.
  assignedEnquiries    Enquiry[]         @relation("enquiry_assigned_driver")

  current_vehicle_id  Int?    @unique // Currently assigned vehicle (first-class entity)

  @@index([driver_code], name: "idx_drivers_code")
  @@index([user_id], name: "idx_drivers_user")
  @@index([partner_id], name: "idx_drivers_partner")
  @@index([transport_owner_id], name: "idx_drivers_transport_owner")
  @@index([license_number], name: "idx_drivers_license")
  @@index([status], name: "idx_drivers_status")
  @@index([mobile], name: "idx_drivers_mobile")
  @@index([alternate_mobile], name: "idx_drivers_alt_mobile")
  @@index([city], name: "idx_drivers_city")
  @@index([state], name: "idx_drivers_state")
  @@index([current_vehicle_id], name: "idx_drivers_current_vehicle")
  @@map("drivers")
}

// --- Driver Financial Transactions (Ledger) ---
model DriverTransaction {
  transaction_id   Int       @id @default(autoincrement())
  driver_id        Int
  transaction_type String    // advance, trip_payment, fuel_expense, toll_expense, other_expense, recovery
  amount           Float
  balance_before   Float
  balance_after    Float
  description      String?
  reference_type   String?   // booking, vehicle, etc.
  reference_id     Int?
  payment_mode     String?   // cash, bank, upi, etc.
  transaction_date DateTime? @default(now())
  recorded_by      Int?      // admin_id
  notes            String?
  created_at       DateTime? @default(now())

  // Relations
  driver Driver @relation(fields: [driver_id], references: [driver_id], onDelete: Cascade)

  @@index([driver_id], name: "idx_driver_tx_driver")
  @@index([transaction_type], name: "idx_driver_tx_type")
  @@index([transaction_date], name: "idx_driver_tx_date")
  @@map("driver_transactions")
}

// --- Driver Timeline / Activity Log ---
model DriverTimeline {
  event_id      Int       @id @default(autoincrement())
  driver_id     Int
  event_type    String    // driver_created, vehicle_assigned, trip_started, trip_completed, advance_given, fuel_added, payment_recorded, status_changed
  description   String
  reference_type String?  // booking, vehicle, transaction
  reference_id  Int?
  metadata      String?   // JSON payload for additional context
  created_at    DateTime? @default(now())

  // Relations
  driver Driver @relation(fields: [driver_id], references: [driver_id], onDelete: Cascade)

  @@index([driver_id], name: "idx_driver_timeline_driver")
  @@index([event_type], name: "idx_driver_timeline_event")
  @@index([created_at], name: "idx_driver_timeline_date")
  @@map("driver_timeline")
}

// --- Vehicle Owners ---
model VehicleOwner {
  owner_id            Int           @id @default(autoincrement())
  owner_code          String?       @unique    // Auto-generated: VOW000001 (nullable for migration)
  owner_name          String
  company_name        String?
  email               String?
  mobile              String
  alternate_mobile    String?
  city                String?
  state               String?       @default("Bihar")
  gst_number          String?
  pan_number          String?
  bank_account        String?
  bank_ifsc           String?
  bank_name           String?
  upi_id              String?
  address             String?
  status              String?   @default("active") // active, inactive, suspended
  owner_type          String?   @default("TRANSPORT_COMPANY") // TRANSPORT_COMPANY, INDIVIDUAL_OWNER, DRIVER_OWNER
  notes               String?
  is_active           Boolean?  @default(true)
  created_at          DateTime?     @default(now())
  updated_at          DateTime?     @default(now())
  deleted_at          DateTime?     // Soft delete
  partner_link        Int?      @unique  // FK to Partner.partner_id (nullable, 1:1)

  // Relations
  vehicles            TransportVehicle[] @relation("vehicle_owner")
  drivers             Driver[]           @relation("transport_owner_drivers")
  applications        PartnerApplication[] @relation("vehicle_owner_applications")
// Relations
  bookings            Booking[]
  trips               Trip[]
  linkedPartner       Partner?           @relation("vehicle_owner_link", fields: [partner_link], references: [partner_id], onDelete: SetNull)
  assignedEnquiries   Enquiry[]          @relation("enquiry_assigned_owner")

  @@index([owner_code], name: "idx_vehicle_owner_code")
  @@index([mobile], name: "idx_vehicle_owner_mobile")
  @@index([status], name: "idx_vehicle_owner_status")
  @@index([city], name: "idx_vehicle_owner_city")
  @@index([state], name: "idx_vehicle_owner_state")
  @@index([is_active], name: "idx_vehicle_owner_active")
  @@index([owner_type], name: "idx_vehicle_owner_type")
  @@index([partner_link], name: "idx_vehicle_owner_partner_link")
  @@map("vehicle_owners")
}

// --- Transport Vehicles ---
model TransportVehicle {
  vehicle_id           Int           @id @default(autoincrement())
  vehicle_code         String?       @unique    // Auto-generated: VEH000001 (nullable for migration)
  driver_id            Int?
  owner_id             Int?          // Vehicle owner (who owns this vehicle)
  partner_id           Int?          // Network partner who sourced this vehicle (nullable)
  vehicle_number       String        @unique
  vehicle_type         String        // ENUM stored as TEXT in SQLite
  vehicle_name         String?
  capacity_kg          Float?
  capacity_volume      Float?
  body_type            String?       // Open body, closed body, container, etc.
  vehicle_make         String?
  vehicle_model        String?
  manufacturing_year   Int?
  registration_date    String?
  insurance_number     String?
  insurance_expiry     String?
  permit_number        String?
  permit_expiry        String?
  pollution_certificate String?
  pollution_expiry     String?
  is_available         Boolean?      @default(true)
  is_verified          Boolean?      @default(false)
  current_status       String?       @default("available")
  base_location        String?
  hourly_rate          Float?
  per_km_rate          Float?
  created_at           DateTime?     @default(now())
  updated_at           DateTime?     @default(now())

// Relations
  driver              Driver?         @relation("current_driver_vehicle")
  owner               VehicleOwner?   @relation("vehicle_owner", fields: [owner_id], references: [owner_id], onDelete: SetNull)
  sourcePartner       Partner?        @relation("sourced_vehicles", fields: [partner_id], references: [partner_id], onDelete: SetNull)
  bookings            Booking[]
  deliveries          Delivery[]
  bookingAssignments  BookingAssignment[]
// Relations
// Relations
  reservations        Reservation[]
  vehicleAssignments  VehicleAssignment[]
  trips                Trip[]
  assignedEnquiries    Enquiry[]     @relation("enquiry_assigned_vehicle")
  requestedEnquiries   Enquiry[]     @relation("enquiry_requested_vehicle")

  @@index([driver_id], name: "idx_vehicles_driver")
  @@index([owner_id], name: "idx_vehicles_owner")
  @@index([partner_id], name: "idx_vehicles_partner")
  @@index([vehicle_number], name: "idx_vehicles_number")
  @@index([vehicle_type], name: "idx_vehicles_type")
  @@index([is_available], name: "idx_vehicles_available")
  @@map("transport_vehicles")
}

// --- Bookings ---
model Booking {
  booking_id            Int       @id @default(autoincrement())
  booking_reference     String?   @unique // Legacy / backward-compat alias (nullable)
  booking_number        String    @unique // CANONICAL booking number: BTB-YYYY-NNNNN
  user_id               Int
  driver_id             Int?
  vehicle_id            Int?                  // Assigned transport vehicle (nullable)
  partner_id            Int?                  // Network partner who sourced this booking (nullable)
  vehicle_owner_id      Int?                  // Vehicle owner (nullable - for owned vehicles)

  // Snapshot data (immutable - preserves historical accuracy)
  partner_name_snapshot   String?             // Partner name at time of booking
  driver_name_snapshot    String?             // Driver name at time of booking
  truck_number_snapshot   String?             // Truck number at time of booking
  mobile_snapshot         String?             // Contact mobile at time of booking

  // Commission fields
  commission_percentage Float?    @default(0) // Commission % for this booking
  commission_amount     Float?    @default(0) // Calculated commission amount
  commission_type       String?   @default("percentage") // "percentage" or "fixed"

  // Settlement fields
  settlement_status     String?   @default("pending") // pending, settled, locked
  settlement_id         Int?                          // FK to settlement

  // Trip financial fields (driver/owner payout agreed at booking level)
  driver_payout               Float?   // Agreed payout to driver/vehicle
  owner_settlement_amount     Float?   // Agreed settlement amount for owner

  pickup_location       String
  pickup_address        String?
  pickup_city           String
  pickup_state          String?   @default("Bihar")
  pickup_pincode        String?
  pickup_date           String
  pickup_time           String
  drop_location         String
  drop_address          String?
  drop_city             String
  drop_state            String?   @default("Bihar")
  drop_pincode          String?
  goods_description     String
  goods_type            String?
  goods_weight_kg       Float?
  goods_volume          Float?
  number_of_items       Int?      @default(1)
  fragile               Boolean?  @default(false)
  // Material + Quantity + Weight unit fields (Step 2)
  // goods_description is reused as the material/goods name.
  // number_of_items is reused as the quantity number.
  // goods_weight_kg is reused as the weight value.
  quantity_unit         String?   // e.g. Bags, Boxes, PCS, Bundles, LOOSE
  weight_unit           String?   // e.g. KG, Tons, Quintal, Metric Ton, FTL
  // Free-text handling/delivery notes typed by the customer on the booking form.
  // Nullable so existing booking rows are unaffected.
  special_instructions  String?
  vehicle_type_required String
  estimated_distance_km Float?
  estimated_price       Float?
  final_price           Float?
  status                String?   @default("pending")
  // Quote-based brokerage workflow fields.
  // quote_status: PENDING → SENT → ACCEPTED | REJECTED
  quote_status          String?   @default("PENDING")
  // Who confirmed this booking: CUSTOMER (online accept) or ADMIN (offline /
  // phone/WhatsApp manual confirmation). Single source: quote_status is the
  // driver of confirmation; this field records the confirmation channel.
  confirmation_source    String?  // "CUSTOMER" | "ADMIN"
  quote_remarks         String?
  quote_sent_at         DateTime?
  quote_accepted_at     DateTime?
  quote_valid_until     DateTime?  // When the sent quote expires (backend-validated)
  quote_rejected_at     DateTime?
  created_at            DateTime? @default(now())
  updated_at            DateTime? @default(now())
  confirmed_at          DateTime?
  driver_assigned_at    DateTime?
  pickup_completed_at   DateTime?
  delivered_at          DateTime?
// Relations
  archived_at           DateTime?  // Soft-delete / archive timestamp

// Relations
user               User              @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
// Reverse link to the pre-booking Enquiry that this Booking was created from.
// Nullable so every pre-existing Booking row remains valid.
enquiry            Enquiry?          @relation("enquiry_booking")
driver             Driver?           @relation(fields: [driver_id], references: [driver_id], onDelete: SetNull)
  vehicle            TransportVehicle? @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: SetNull)
  partner            Partner?          @relation(fields: [partner_id], references: [partner_id], onDelete: SetNull)
  vehicleOwner       VehicleOwner?     @relation(fields: [vehicle_owner_id], references: [owner_id], onDelete: SetNull)
  bookingSettlement  Settlement?       @relation(fields: [settlement_id], references: [settlement_id], onDelete: SetNull)
  delivery           Delivery?
  bookingEvents      BookingEvent[]
  bookingAssignments BookingAssignment[]
  reservations       Reservation[]
  invoices           Invoice[]
  ledgerEntries      PartnerLedger[] @relation("ledger_entries")
  tripFinancial      TripFinancial?
  tripAdvances       TripAdvance[]
  tripSettlements    TripSettlement[]
  commissionRecords  CommissionRecord[]
  financialTransactions FinancialTransaction[]
  trips              Trip[]

// Indexes
// Indexes
  @@index([user_id], name: "idx_bookings_user")
  @@index([driver_id], name: "idx_bookings_driver")
  @@index([vehicle_id], name: "idx_bookings_vehicle")
  @@index([partner_id], name: "idx_bookings_partner")
  @@index([vehicle_owner_id], name: "idx_bookings_vehicle_owner")
  @@index([booking_reference], name: "idx_bookings_reference")
  @@index([status], name: "idx_bookings_status")
  @@index([pickup_date], name: "idx_bookings_date")
  @@index([booking_number], name: "idx_bookings_booking_number")
  @@index([settlement_id], name: "idx_bookings_settlement")
  @@map("bookings")
}

// --- Deliveries ---
model Delivery {
  delivery_id           Int       @id @default(autoincrement())
  booking_id            Int       @unique
  driver_id             Int?
  vehicle_id            Int?
  current_status        String?   @default("booking_confirmed")
  status_description    String?
  current_latitude      Float?
  current_longitude     Float?
  last_location_update  DateTime?
  estimated_pickup_time DateTime?
  actual_pickup_time    DateTime?
  estimated_delivery_time DateTime?
  actual_delivery_time  DateTime?
  delivery_otp          String?
  otp_verified          Boolean?  @default(false)
  delivery_proof_image  String?
  delivery_notes        String?
  recipient_name        String?
  created_at            DateTime? @default(now())
  updated_at            DateTime? @default(now())

  // Relations
  booking Booking?       @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  driver  Driver?        @relation(fields: [driver_id], references: [driver_id], onDelete: SetNull)
  vehicle TransportVehicle? @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: SetNull)

  @@index([booking_id], name: "idx_deliveries_booking")
  @@index([driver_id], name: "idx_deliveries_driver")
  @@index([vehicle_id], name: "idx_deliveries_vehicle")
  @@index([current_status], name: "idx_deliveries_status")
  @@map("deliveries")
}

// --- Admins ---
model Admin {
  admin_id      Int       @id @default(autoincrement())
  username      String    @unique
  email         String    @unique
  password_hash String
  full_name     String
  phone         String?
  role          String?   @default("admin")
  is_active     Boolean?  @default(true)
  created_at    DateTime? @default(now())
  updated_at    DateTime? @default(now())

// Relations
  bookingAssignments BookingAssignment[] @relation("assigned_by_admin")
  enquiryQuotes      Enquiry[]          @relation("enquiry_quoted_by")

  @@map("admins")
}

// --- Booking Events ---
model BookingEvent {
  booking_event_id Int       @id @default(autoincrement())
  booking_id       Int
  event_type       String
  event_payload    String?
  created_at       DateTime? @default(now())

  // Relations
  booking Booking @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)

  @@index([booking_id], name: "idx_booking_events_booking_id")
  @@index([event_type], name: "idx_booking_events_event_type")
  @@index([created_at], name: "idx_booking_events_created_at")
  @@map("booking_events")
}

// --- Booking Assignments ---
model BookingAssignment {
  booking_assignment_id Int       @id @default(autoincrement())
  booking_id            Int
  assigned_driver_id    Int?
  assigned_vehicle_id   Int?
  assigned_by_admin_id  Int?
  assignment_status     String?   @default("active")
  created_at            DateTime? @default(now())

  // Relations
  booking       Booking?          @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  assignedDriver Driver?          @relation("assigned_driver", fields: [assigned_driver_id], references: [driver_id], onDelete: SetNull)
  assignedVehicle TransportVehicle? @relation(fields: [assigned_vehicle_id], references: [vehicle_id], onDelete: SetNull)
  assignedByAdmin Admin?          @relation("assigned_by_admin", fields: [assigned_by_admin_id], references: [admin_id], onDelete: SetNull)

  @@index([booking_id], name: "idx_booking_assignments_booking_id")
  @@index([assigned_driver_id], name: "idx_booking_assignments_driver_id")
  @@index([assigned_vehicle_id], name: "idx_booking_assignments_vehicle_id")
  @@index([created_at], name: "idx_booking_assignments_created_at")
  @@map("booking_assignments")
}

// ============================================================
// TRANSPORT PARTNER MODULE
// ============================================================

// --- Transport Partners (Network Partners) ---
model Partner {
  partner_id        Int          @id @default(autoincrement())
  partner_code      String?      @unique    // Auto-generated: PRT000001 (nullable for migration)
  partner_name      String
  owner_name        String
  company_name      String?
  email             String?
  mobile            String
  alternate_mobile  String?
  city              String?
  state             String?       @default("Bihar")
  gst_number        String?
  pan_number        String?
  bank_account      String?
  bank_ifsc         String?
  bank_name         String?
  upi_id            String?
  address           String?
  status            PartnerStatus @default(active)
  notes             String?
  // Network/capacity information
  available_capacity String?     // Description of available transport capacity
  network_locations  String?     // JSON: cities/routes this partner can service
  commission_percentage Float?   @default(10) // Default 10% commission
  commission_type   String?      @default("percentage") // "percentage" or "fixed"
  fixed_commission  Float?       @default(0) // Fixed commission amount if type is "fixed"
  is_active         Boolean?     @default(true)
  created_at        DateTime?    @default(now())
  updated_at        DateTime?    @default(now())
  deleted_at        DateTime?    // Soft delete
  partner_capability String?     @default("PARTNER_ONLY") // PARTNER_ONLY, TRANSPORT_OPERATOR, BOTH

  // Relations
  sourcedVehicles   TransportVehicle[] @relation("sourced_vehicles")
  drivers           Driver[]            @relation("current_partner_drivers")
  bookings          Booking[]
  ledgerEntries     PartnerLedger[]
  payments          PartnerPayment[]
  settlements       Settlement[]
  documents         PartnerDocument[]
// Relations
  driverAssignments DriverAssignment[]  @relation("partner_assignments")
  applications      PartnerApplication[]
  linkedVehicleOwner VehicleOwner?      @relation("vehicle_owner_link")
  assignedEnquiries Enquiry[]          @relation("enquiry_assigned_partner")

  @@index([partner_code], name: "idx_partner_code")
  @@index([mobile], name: "idx_partner_mobile")
  @@index([status], name: "idx_partner_status")
  @@index([city], name: "idx_partner_city")
  @@index([state], name: "idx_partner_state")
  @@index([is_active], name: "idx_partner_active")
  @@index([partner_capability], name: "idx_partner_capability")
  @@map("partners")
}

// --- Partner Driver Assignments (history) ---
model DriverAssignment {
  assignment_id     Int       @id @default(autoincrement())
  driver_id         Int
  partner_id        Int
  assigned_by       Int?      // Admin ID who assigned
  assigned_at       DateTime? @default(now())
  unassigned_at     DateTime? // When driver was removed from this partner
  status            String?   @default("active") // active, inactive
  notes             String?
  created_at        DateTime? @default(now())

  // Relations
  driver  Driver  @relation("assigned_driver_history", fields: [driver_id], references: [driver_id], onDelete: Cascade)
  partner Partner @relation("partner_assignments", fields: [partner_id], references: [partner_id], onDelete: Cascade)

  @@index([driver_id], name: "idx_drv_assign_driver")
  @@index([partner_id], name: "idx_drv_assign_partner")
  @@index([status], name: "idx_drv_assign_status")
  @@map("driver_assignments")
}

// --- Vehicle Driver Assignments (history) ---
model VehicleAssignment {
  assignment_id     Int       @id @default(autoincrement())
  vehicle_id        Int
  driver_id         Int
  assigned_by       Int?      // Admin ID who assigned
  assigned_at       DateTime? @default(now())
  unassigned_at     DateTime? // When driver was unassigned from this vehicle
  status            String?   @default("active") // active, inactive
  notes             String?
  created_at        DateTime? @default(now())

  // Relations
  vehicle TransportVehicle @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade)
  driver  Driver           @relation("assigned_driver", fields: [driver_id], references: [driver_id], onDelete: Cascade)

  @@index([vehicle_id], name: "idx_veh_assign_vehicle")
  @@index([driver_id], name: "idx_veh_assign_driver")
  @@index([status], name: "idx_veh_assign_status")
  @@map("vehicle_assignments")
}

// --- Partner Ledger (immutable accounting) ---
model PartnerLedger {
  ledger_id         Int                  @id @default(autoincrement())
  partner_id        Int
  booking_id        Int?                 // Optional link to booking
  transaction_id    String               @unique // Auto-generated: LED-YYYYMMDD-XXXXX
  transaction_type  LedgerTransactionType
  date              DateTime?            @default(now())
  description       String?
  debit             Float?               @default(0)
  credit            Float?               @default(0)
  running_balance   Float                @default(0) // Calculated running balance
  payment_mode      String?              // cash, bank, upi, cheque
  remarks           String?
  reference_number  String?              // Cheque number, transaction ref, etc.
  created_by        Int?                 // Admin ID who created this entry
  is_reversal       Boolean?             @default(false) // True if this is a reversal entry
  reversal_of       String?              // transaction_id of the original entry being reversed
  created_at        DateTime?             @default(now())

// Relations
  partner Partner @relation(fields: [partner_id], references: [partner_id], onDelete: Cascade)
  booking Booking? @relation("ledger_entries", fields: [booking_id], references: [booking_id], onDelete: SetNull)

  @@index([partner_id], name: "idx_ledger_partner")
  @@index([booking_id], name: "idx_ledger_booking")
  @@index([transaction_type], name: "idx_ledger_type")
  @@index([date], name: "idx_ledger_date")
  @@index([transaction_id], name: "idx_ledger_txn_id")
  @@index([created_at], name: "idx_ledger_created")
  @@map("partner_ledger")
}

// --- Partner Payments ---
model PartnerPayment {
  payment_id        Int       @id @default(autoincrement())
  payment_number    String    @unique    // Auto-generated: PAY-YYYYMMDD-XXXXX
  partner_id        Int
  amount            Float
  payment_method    String    // cash, bank_transfer, upi, cheque
  reference_number  String?   // Transaction ref, cheque number, UPI ref
  date              DateTime? @default(now())
  created_by        Int?      // Admin ID
  status            String?   @default("pending") // pending, paid, partially_paid, cancelled
  remarks           String?
  settlement_id     Int?      // Optional link to settlement
  created_at        DateTime? @default(now())
  updated_at        DateTime? @default(now())

  // Relations
  partner    Partner    @relation(fields: [partner_id], references: [partner_id], onDelete: Cascade)
  settlement Settlement? @relation(fields: [settlement_id], references: [settlement_id], onDelete: SetNull)

  @@index([partner_id], name: "idx_payment_partner")
  @@index([payment_number], name: "idx_payment_number")
  @@index([status], name: "idx_payment_status")
  @@index([date], name: "idx_payment_date")
  @@map("partner_payments")
}

// --- Monthly Settlements ---
model Settlement {
  settlement_id     Int              @id @default(autoincrement())
  settlement_number String           @unique // Auto-generated: STL-YYYYMM-XXXXX
  partner_id        Int
  month             Int              // 1-12
  year              Int              // e.g. 2026
  total_bookings    Int?             @default(0)
  gross_revenue     Float?           @default(0)
  commission        Float?           @default(0)
  fuel_advance      Float?           @default(0)
  driver_advance    Float?           @default(0)
  repair_amount     Float?           @default(0)
  toll_amount       Float?           @default(0)
  penalty_amount    Float?           @default(0)
  bonus_amount      Float?           @default(0)
  other_expenses    Float?           @default(0)
  net_payable       Float?           @default(0) // gross_revenue - commission - all advances
  amount_paid       Float?           @default(0)
  balance_due       Float?           @default(0)
  status            SettlementStatus @default(pending)
  locked_at         DateTime?        // When settlement was locked
  settled_at        DateTime?        // When fully settled
  notes             String?
  pdf_url           String?          // Path to generated PDF
  created_at        DateTime?        @default(now())
  updated_at        DateTime?        @default(now())

  // Relations
  partner  Partner          @relation(fields: [partner_id], references: [partner_id], onDelete: Cascade)
  bookings Booking[]
  payments PartnerPayment[]

  @@index([partner_id], name: "idx_settlement_partner")
  @@index([settlement_number], name: "idx_settlement_number")
  @@index([month, year], name: "idx_settlement_month_year")
  @@index([status], name: "idx_settlement_status")
  @@map("settlements")
}

// --- Partner Documents ---
model PartnerDocument {
  document_id   Int                  @id @default(autoincrement())
  partner_id    Int
  document_type PartnerDocumentType
  document_name String
  file_url      String
  file_size     Int?                 // Size in bytes
  mime_type     String?
  expiry_date   DateTime?            // For insurance, RC, etc.
  is_verified   Boolean?             @default(false)
  notes         String?
  uploaded_by   Int?                 // Admin ID
  created_at    DateTime?            @default(now())
  updated_at    DateTime?            @default(now())

  // Relations
  partner Partner @relation(fields: [partner_id], references: [partner_id], onDelete: Cascade)

  @@index([partner_id], name: "idx_doc_partner")
  @@index([document_type], name: "idx_doc_type")
  @@index([expiry_date], name: "idx_doc_expiry")
@@map("partner_documents")
}

// --- Partner Applications (public registration → admin review) ---
model PartnerApplication {
  application_id    Int       @id @default(autoincrement())
  application_code  String?   @unique // Auto-generated: PPA-YYYY-NNNNN (nullable for migration)

  // Applicant details
  first_name        String
  last_name         String
  email             String
  phone             String
  password_hash      String    // Hashed password for when approved

  // Business details
  partnership_type  String    // "vehicle_owner" or "transport_owner"
  company_name      String?
  gst_number        String?
  pan_number        String?
  city              String?
  state             String?   @default("Bihar")

  // Additional fields
  address           String?
  vehicle_number    String?   // For vehicle owner
  vehicle_type      String?   // For vehicle owner
  number_of_vehicles Int?     // For transport owner
  available_capacity String?  // For transport owner
  network_locations  String?  // For transport owner

  // Review
  status            String    @default("pending") // pending, approved, rejected
  reviewed_by       Int?      // Admin ID
  reviewed_at       DateTime?
  rejection_reason  String?
  admin_notes       String?

  // Linked records (set on approval)
  partner_id        Int?      // FK to Partner (set when approved for transport_owner)
  vehicle_owner_id  Int?      // FK to VehicleOwner (set when approved for vehicle_owner)
  user_id           Int?      // FK to User (set when approved)

  // Relations
  partner          Partner?        @relation(fields: [partner_id], references: [partner_id], onDelete: SetNull)
  vehicleOwner     VehicleOwner?   @relation("vehicle_owner_applications", fields: [vehicle_owner_id], references: [owner_id], onDelete: SetNull)
  user             User?           @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  created_at        DateTime? @default(now())
  updated_at        DateTime? @default(now())

  @@index([phone], name: "idx_app_phone")
  @@index([email], name: "idx_app_email")
  @@index([status], name: "idx_app_status")
  @@index([partnership_type], name: "idx_app_type")
  @@map("partner_applications")
}

// ============================================================
// QUOTE WORKFLOW MODULE
// ============================================================

// --- Reservations (driver/vehicle held before customer approval) ---
// Single source of truth for reserved driver/vehicle during the quote
// workflow. Booking only holds business state (status, quote_status, price).
model Reservation {
  reservation_id   Int               @id @default(autoincrement())
  booking_id       Int
  driver_id        Int?
  vehicle_id       Int?
  status           ReservationStatus @default(ACTIVE)
  expires_at       DateTime?         // When the reservation expires
  released_at      DateTime?
  converted_at     DateTime?
  reserved_by      Int?              // Admin ID who reserved
  created_at       DateTime?         @default(now())
  updated_at       DateTime?         @default(now())

  // Relations
  booking  Booking?          @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  driver   Driver?           @relation(fields: [driver_id], references: [driver_id], onDelete: SetNull)
  vehicle  TransportVehicle? @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: SetNull)

  @@index([booking_id], name: "idx_reservations_booking")
  @@index([driver_id], name: "idx_reservations_driver")
  @@index([vehicle_id], name: "idx_reservations_vehicle")
  @@index([status], name: "idx_reservations_status")
  @@index([expires_at], name: "idx_reservations_expires")
  @@map("reservations")
}

// --- Invoices (generated on delivery completion, NOT quote accept) ---
// Module is ready for the future billing workflow. Not auto-generated on
// quote acceptance.
model Invoice {
  invoice_id      Int           @id @default(autoincrement())
  invoice_number  String        @unique
  booking_id      Int
  final_price     Float
  status          InvoiceStatus @default(PENDING)
  goods_amount    Float?
  vehicle_charge  Float?
  extra_charges   Float?        @default(0)
  discount        Float?        @default(0)
  total_amount    Float?
  tax_amount      Float?        @default(0)
  grand_total     Float?
  issued_at       DateTime?
  due_at          DateTime?
  paid_at         DateTime?
  notes           String?
  created_at      DateTime?     @default(now())
  updated_at      DateTime?     @default(now())

  // Relations
  booking Booking @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)

  @@index([invoice_number], name: "idx_invoices_number")
  @@index([booking_id], name: "idx_invoices_booking")
  @@index([status], name: "idx_invoices_status")
  @@map("invoices")
}

// ============================================================
// TRIP FINANCIAL MODULE
// ============================================================

// --- Trip Financial Summary ---
// Per-trip financial snapshot. This is the single source of truth
// for one trip's complete financial picture.
model TripFinancial {
  trip_financial_id     Int              @id @default(autoincrement())
  booking_id            Int?             @unique    // Nullable: standalone trips have no booking
  trip_id               Int?             // Direct trip link for standalone trips (Phase 3)
  status                TripFinancialStatus @default(DRAFT)

  // Customer revenue
  customer_fare         Float            // Total amount customer paid

  // Driver/vehicle costs
  driver_payout         Float?           // Agreed payout to driver/vehicle
  total_advance         Float?           @default(0) // Sum of all driver advances
  total_fuel_advance    Float?           @default(0) // Sum of all fuel advances
  remaining_driver_settlement Float?     @default(0) // driver_payout - total_advance - total_fuel_advance

  // Owner settlement
  owner_settlement_amount Float?         // Agreed owner settlement
  total_owner_advance   Float?           @default(0) // Sum of all owner advances
  remaining_owner_settlement Float?      @default(0) // owner_settlement - total_owner_advance

  // Commission
  commission_rate       Float?           @default(5) // Configurable commission rate
  commission_amount     Float?           @default(0) // Calculated commission

  // BT Margin (ADMIN ONLY - confidential)
  bt_margin             Float?           @default(0) // customer_fare - driver_payout - commission

  // Metadata
  calculated_at         DateTime?
  calculated_by         Int?             // Admin ID who calculated
  notes                 String?
  created_at            DateTime?        @default(now())
  updated_at            DateTime?        @default(now())

  // Relations
  booking       Booking?             @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  trip          Trip?                @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)
  advances      TripAdvance[]
  settlements   TripSettlement[]
  commissions   CommissionRecord[]
  transactions  FinancialTransaction[]

  @@index([booking_id], name: "idx_trip_financial_booking")
  @@index([trip_id], name: "idx_trip_financial_trip")
  @@index([status], name: "idx_trip_financial_status")
  @@map("trip_financials")
}

// --- Trip Advance ---
// Individual advance records for a trip. Never overwrite previous advances.
// Supports both booking-linked advances (legacy) and direct trip advances (Phase 1).
model TripAdvance {
  advance_id            Int       @id @default(autoincrement())
  trip_financial_id     Int?
  booking_id            Int?
  trip_id               Int?      // Direct trip link for standalone trips (Phase 1)
  driver_id             Int?
  vehicle_id            Int?
  transport_owner_id    Int?
  amount                Float
  advance_type          AdvanceType
  payment_method        String    // cash, bank, upi, etc.
  reference_number      String?
  given_by              Int?      // Admin ID who gave the advance
  given_at              DateTime? @default(now())
  notes                 String?
  status                String?   @default("pending") // pending, approved, paid, cancelled
  created_at            DateTime? @default(now())
  updated_at            DateTime? @default(now())

  // Relations
  tripFinancial TripFinancial? @relation(fields: [trip_financial_id], references: [trip_financial_id], onDelete: Cascade)
  booking       Booking?       @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  trip          Trip?          @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)

  @@index([trip_financial_id], name: "idx_trip_advance_financial")
  @@index([booking_id], name: "idx_trip_advance_booking")
  @@index([trip_id], name: "idx_trip_advance_trip")
  @@index([driver_id], name: "idx_trip_advance_driver")
  @@index([transport_owner_id], name: "idx_trip_advance_owner")
  @@map("trip_advances")
}

// --- Trip Settlement ---
// Per-trip settlement records for driver and owner.
model TripSettlement {
  settlement_id             Int       @id @default(autoincrement())
  trip_financial_id         Int
  booking_id                Int?      // Nullable for standalone trips
  trip_id                   Int?      // Direct trip link for standalone trips (Phase 1)

  // Driver settlement
  driver_settlement_amount  Float?
  driver_settlement_status  PaymentStatus @default(PENDING)
  driver_settlement_paid_at DateTime?
  driver_settlement_payment_method String?
  driver_settlement_reference String?
  driver_settlement_notes   String?

  // Owner settlement
  owner_settlement_amount   Float?
  owner_settlement_status   PaymentStatus @default(PENDING)
  owner_settlement_paid_at  DateTime?
  owner_settlement_payment_method String?
  owner_settlement_reference String?
  owner_settlement_notes    String?

  // General
  created_at                DateTime? @default(now())
  updated_at                DateTime? @default(now())

  // Relations
  tripFinancial TripFinancial @relation(fields: [trip_financial_id], references: [trip_financial_id], onDelete: Cascade)
  booking       Booking?      @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  trip          Trip?          @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)

  @@index([trip_financial_id], name: "idx_trip_settlement_financial")
  @@index([booking_id], name: "idx_trip_settlement_booking")
  @@index([trip_id], name: "idx_trip_settlement_trip")
  @@map("trip_settlements")
}

// --- Commission Record ---
// Per-trip commission tracking with full audit trail.
model CommissionRecord {
  commission_id         Int       @id @default(autoincrement())
  trip_financial_id     Int
  booking_id            Int
  commission_rate       Float
  commission_type       String    @default("percentage") // "percentage" or "fixed"
  commission_base       Float     // The amount on which commission is calculated
  commission_amount     Float
  applied_at            DateTime? @default(now())
  applied_by            Int?      // Admin ID who applied commission
  notes                 String?
  created_at            DateTime? @default(now())

  // Relations
  tripFinancial TripFinancial @relation(fields: [trip_financial_id], references: [trip_financial_id], onDelete: Cascade)
  booking       Booking       @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)

  @@index([trip_financial_id], name: "idx_commission_financial")
  @@index([booking_id], name: "idx_commission_booking")
  @@map("commission_records")
}

// --- Financial Transaction ---
// Central transaction ledger. Every financial event creates one entry here.
// This is the SINGLE SOURCE OF TRUTH for all trip financials.
model FinancialTransaction {
  transaction_id    Int                  @id @default(autoincrement())
  trip_financial_id Int
  booking_id        Int?                 // Nullable: standalone trips have no booking
  trip_id           Int?                 // Direct trip link for standalone trips
  vehicle_id        Int?
  driver_id         Int?
  transport_owner_id Int?
  client_id         Int?                 // For offline client payments

  transaction_type  FinancialTransactionType
  amount            Float
  direction         TransactionDirection   // DEBIT = money out from BT, CREDIT = money in to BT
  from_party        TransactionParty?     // Who paid / from whom
  to_party          TransactionParty?     // Who received / to whom
  purpose           String?               // Human-readable purpose
  payment_method    String?               // cash, bank, upi, cheque, etc.
  reference_number  String?
  transaction_date  DateTime?             // When the transaction occurred
  status            PaymentStatus         @default(PAID)
  metadata          String?               // JSON payload for additional context
  notes             String?

  created_by        Int?                  // Admin/User ID who created this
  created_at        DateTime?             @default(now())
  updated_at        DateTime?             @default(now())

  // Relations
  tripFinancial TripFinancial @relation(fields: [trip_financial_id], references: [trip_financial_id], onDelete: Cascade)
  booking       Booking?      @relation(fields: [booking_id], references: [booking_id], onDelete: Cascade)
  trip          Trip?          @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)

  @@index([trip_financial_id], name: "idx_financial_tx_financial")
  @@index([booking_id], name: "idx_financial_tx_booking")
  @@index([trip_id], name: "idx_financial_tx_trip")
  @@index([transaction_type], name: "idx_financial_tx_type")
  @@index([from_party], name: "idx_financial_tx_from")
  @@index([to_party], name: "idx_financial_tx_to")
  @@index([transaction_date], name: "idx_financial_tx_date")
  @@index([created_at], name: "idx_financial_tx_created")
  @@map("financial_transactions")
}

// --- Audit Log ---
// Every sensitive action creates an audit record.
model AuditLog {
  audit_id       Int       @id @default(autoincrement())
  user_id        Int?      // Who performed the action
  user_role      String    // admin, driver, owner, etc.
  action         String    // e.g., "payout_changed", "advance_created", "settlement_approved"
  entity_type    String    // e.g., "Booking", "TripFinancial", "TripAdvance"
  entity_id      Int       // ID of the entity
  previous_value String?   // JSON snapshot of previous state
  new_value      String?   // JSON snapshot of new state
  reason         String?
  ip_address     String?
  user_agent     String?
  created_at     DateTime? @default(now())

  @@index([user_id], name: "idx_audit_user")
  @@index([entity_type, entity_id], name: "idx_audit_entity")
  @@index([action], name: "idx_audit_action")
  @@index([created_at], name: "idx_audit_created")
  @@map("audit_logs")
}

// ============================================================
// TRIP MANAGEMENT MODULE
// ============================================================

// --- Trip ---
// Central entity for offline/online trip management.
// A Trip can be created independently or from a Booking.
model Trip {
  trip_id            Int       @id @default(autoincrement())
  trip_number        String    @unique // BTBT-YYYY-NNNNN
  source_type        TripSourceType @default(ONLINE_BOOKING)
  booking_id         Int?      // Optional link to existing booking
  user_id            Int?      // Online customer (User) — null for offline/direct
  client_id          Int?      // Offline corporate client — null for online/direct
  transport_owner_id Int       // Transport Owner (VehicleOwner)
  vehicle_id         Int       // Vehicle (TransportVehicle)
  driver_id          Int       // Driver

  // Route
  pickup_location    String
  pickup_city        String
  drop_location      String
  drop_city          String
  distance_km        Float?
  expected_delivery_date DateTime?  // Expected delivery date
  trip_delivered_date    DateTime?  // Actual delivery date

  // Financial (base amounts only - all derived values come from FinancialTransaction)
  freight_amount     Float
  driver_payment     Float?    // Agreed driver payout
  owner_payment      Float?    // Agreed owner settlement
  notes              String?

  // Status
  status             TripStatus @default(PENDING)

  // Timestamps
  trip_date          DateTime?
  created_at         DateTime? @default(now())
  updated_at         DateTime? @default(now())
  completed_at       DateTime?
  cancelled_at       DateTime?

  // Relations
  user               User?             @relation(fields: [user_id], references: [user_id])
  client             Client?           @relation(fields: [client_id], references: [client_id])
  transportOwner     VehicleOwner      @relation(fields: [transport_owner_id], references: [owner_id])
  vehicle            TransportVehicle  @relation(fields: [vehicle_id], references: [vehicle_id])
  driver             Driver            @relation(fields: [driver_id], references: [driver_id])
  booking            Booking?          @relation(fields: [booking_id], references: [booking_id])
  expenses           TripExpense[]
  payments           TripPayment[]
  timeline           TripTimeline[]
  tripAdvances       TripAdvance[]
  tripFinancials     TripFinancial[]
  tripSettlements    TripSettlement[]
  financialTransactions FinancialTransaction[]

  @@index([trip_number], name: "idx_trips_number")
  @@index([user_id], name: "idx_trips_user")
  @@index([transport_owner_id], name: "idx_trips_owner")
  @@index([vehicle_id], name: "idx_trips_vehicle")
  @@index([driver_id], name: "idx_trips_driver")
  @@index([status], name: "idx_trips_status")
  @@index([trip_date], name: "idx_trips_date")
  @@index([booking_id], name: "idx_trips_booking")
  @@map("trips")
}

// --- Trip Expense ---
// Individual expense records for a trip.
// IMPORTANT (Phase 3): `paid_by` distinguishes Bihar Transport expenses
// from Transport Owner expenses. Only paid_by = BIHAR_TRANSPORT expenses
// reduce BT Net Profit. Owner-paid expenses (diesel, maintenance, toll,
// driver wages) are owner-side costs and must NOT appear as BT expenses.
model TripExpense {
  expense_id    Int                  @id @default(autoincrement())
  trip_id       Int
  expense_type  TripExpenseType
  amount        Float
  paid_by       ExpensePaidBy        @default(BIHAR_TRANSPORT)
  paid_to       TransactionParty?    @default(VENDOR)
  expense_date  DateTime?            @default(now())
  description   String?
  receipt       String?              // URL / path to uploaded receipt image
  payment_method String?
  reference_number String?
  created_at    DateTime?            @default(now())
  updated_at    DateTime?            @default(now())

  // Relations
  trip          Trip           @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)

  @@index([trip_id], name: "idx_trip_expenses_trip")
  @@index([expense_type], name: "idx_trip_expenses_type")
  @@index([paid_by], name: "idx_trip_expenses_paid_by")
  @@map("trip_expenses")
}

// --- Trip Payment ---
// Individual payment records for a trip.
model TripPayment {
  payment_id     Int            @id @default(autoincrement())
  trip_id        Int
  amount         Float
  payment_type   TripPaymentType
  payment_category TripPaymentCategory @default(CLIENT_PAYMENT) // Who: CLIENT_PAYMENT, OWNER_PAYMENT, DRIVER_PAYMENT
  payment_date   DateTime?      @default(now())
  payment_method String?        // cash, bank, upi, cheque
  reference      String?
  notes          String?
  created_at     DateTime?      @default(now())
  updated_at     DateTime?      @default(now())

  // Relations
  trip           Trip           @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)

  @@index([trip_id], name: "idx_trip_payments_trip")
  @@index([payment_type], name: "idx_trip_payments_type")
  @@index([payment_category], name: "idx_trip_payments_category")
  @@map("trip_payments")
}

// --- Trip Timeline ---
// Unified timeline for all trip events (status changes, payments, expenses, assignments)
model TripTimeline {
  timeline_id    Int       @id @default(autoincrement())
  trip_id        Int
  event_type     String    // trip_created, status_changed, client_payment, owner_payment,
                           // driver_payment, expense_added, assignment_changed, note_added
  description    String
  reference_type String?   // expense, payment, trip, etc.
  reference_id   Int?
  metadata       String?   // JSON payload for additional context
  created_by     Int?      // Admin/User ID
  created_at     DateTime? @default(now())

  // Relations
  trip Trip @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)

  @@index([trip_id], name: "idx_trip_timeline_trip")
  @@index([event_type], name: "idx_trip_timeline_event")
  @@index([created_at], name: "idx_trip_timeline_date")
  @@map("trip_timeline")
}

// ============================================================
// CLIENT MODULE (Offline Corporate Clients)
// ============================================================

// --- Client ---
// Offline corporate/business accounts with ongoing relationships.
// Distinct from User (online customers) and Partner (transport network partners).
model Client {
  client_id        Int       @id @default(autoincrement())
  client_code      String?   @unique    // Auto-generated: CLI-00001 (nullable for migration)
  company_name     String
  contact_person   String?
  phone            String
  email            String?
  address          String?
  city             String?
  state            String?   @default("Bihar")
  gst_number       String?
  pan_number       String?
  bank_account     String?
  bank_ifsc        String?
  bank_name        String?
 upi_id           String?
  status           String?   @default("active") // active, inactive, suspended
  notes            String?
  is_active        Boolean?  @default(true)
  created_at       DateTime? @default(now())
  updated_at       DateTime? @default(now())
  deleted_at       DateTime? // Soft delete

  // Relations
  trips            Trip[]

// Indexes
  @@index([client_code], name: "idx_client_code")
  @@index([company_name], name: "idx_client_company")
  @@index([phone], name: "idx_client_phone")
  @@index([email], name: "idx_client_email")
  @@index([status], name: "idx_client_status")
  @@index([is_active], name: "idx_client_active")
  @@map("clients")
}

// ============================================================
// ENQUIRY MODULE (PRE-BOOKING CUSTOMER INTAKE)
// ============================================================
//
// ARCHITECTURAL CONTRACT (do not change without reading this):
//
//   Enquiry  ──(customer accepts final quote)──►  Booking  ──►  Trip
//     ▲                                                        ▲
//     │                                                        │
//   intake / quote / acceptance                    existing operational + financial system
//
// The Enquiry is the REQUEST + QUOTATION + ACCEPTANCE record. It is NOT a
// second financial system and it does NOT duplicate the Booking/Trip/financial
// tables. Once the customer accepts, a canonical Booking row is created (via
// the existing BookingService) and linked through Booking.enquiry_id, and the
// Trip/settlement/commission system continues unchanged.
//
// PRIVACY CONTRACT:
// The customer's mobile is stored here (they typed it). The DRIVER's mobile is
// NEVER written to this table and NEVER returned to a customer by any DTO in
// dtos/EnquiryDTO.js — the customer can only reach support via the fixed
// Bihar Transport customer-care WhatsApp number in config/customerCare.js.
model Enquiry {
  enquiry_id            Int            @id @default(autoincrement())

  // Canonical, server-derived, human-readable request id.
  // Format: BTB-YYYYMMDD-NNNNNN  (e.g. BTB-20260926-000123)
  // Derived from the DB autoincrement PK (see EnquiryNumberService) — never
  // from UUID / Math.random() / frontend input.
  enquiry_number        String         @unique

  // ── Customer identity ──────────────────────────────────────────────
  // customer_id is NULL for guest customers (no login wall on submit).
  // Guest access is instead proven by a short-lived signed enquiry access
  // token issued at creation (see EnquiryAccessToken).
  customer_id           Int?
  customer_name         String
  customer_mobile       String
  customer_email        String?
  // Stable per-browser handle so a guest can list their own enquiries later.
  session_key           String?

  // ── Route ──────────────────────────────────────────────────────────
  pickup_location       String
  pickup_address        String?
  pickup_latitude       Float?
  pickup_longitude      Float?
  drop_location         String
  drop_address          String?
  drop_latitude         Float?
  drop_longitude        Float?
  distance_km           Float?

  // ── Vehicle ────────────────────────────────────────────────────────
  // "requested" = what the customer picked on the booking page.
  // "assigned"  = what an admin actually committed to (separate, nullable).
  requested_vehicle_id    Int?
  requested_vehicle_name  String?
  assigned_vehicle_id     Int?
  assigned_driver_id      Int?
  assigned_partner_id     Int?   // network Partner who sourced the trip
  assigned_owner_id       Int?   // VehicleOwner (transport owner)
  // Immutable snapshot so the customer-facing history survives reassignment.
  assigned_vehicle_number String?
  assigned_vehicle_type   String?
  assigned_driver_name    String?
  driver_assigned_at      DateTime?
  vehicle_assigned_at     DateTime?

  // ── Shipment ───────────────────────────────────────────────────────
  // material is NULLABLE: a customer routinely books a vehicle before they
  // know the load, and the transport team captures it on the call. An
  // unanswered field stays NULL — it is never backfilled with a placeholder.
  material              String?
  quantity              Float?
  quantity_unit         String?
  weight                Float?
  weight_unit           String?
  goods_category        String?
  fragile               Boolean         @default(false)
  special_instructions  String?

  // ── Schedule ───────────────────────────────────────────────────────
  pickup_date           DateTime
  pickup_time           String

  // ── Pricing ────────────────────────────────────────────────────────
  // estimated_price_min / max come from the pricing engine at intake time.
  // final_quoted_price is set ONLY by an authenticated admin and is the single
  // server-authoritative price the customer is ever asked to accept.
  estimated_price_min   Float?
  estimated_price_max   Float?
  final_quoted_price    Float?
  price_status          EnquiryPriceStatus @default(NOT_QUOTED)
  quote_remarks         String?
  quoted_by_admin_id    Int?
  quoted_at             DateTime?

  // ── Status ─────────────────────────────────────────────────────────
  status                EnquiryStatus   @default(ENQUIRY_SUBMITTED)
  accepted_at           DateTime?
  rejected_at           DateTime?
  cancelled_at          DateTime?
  cancellation_reason   String?
  confirmed_at          DateTime?
  started_at            DateTime?
  completed_at          DateTime?

  // ── Timestamps ─────────────────────────────────────────────────────
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  // ── Relations ──────────────────────────────────────────────────────
  customer              User?           @relation("enquiry_customer", fields: [customer_id], references: [user_id], onDelete: SetNull)
  requestedVehicle      TransportVehicle? @relation("enquiry_requested_vehicle", fields: [requested_vehicle_id], references: [vehicle_id], onDelete: SetNull)
  assignedVehicle       TransportVehicle? @relation("enquiry_assigned_vehicle", fields: [assigned_vehicle_id], references: [vehicle_id], onDelete: SetNull)
  assignedDriver        Driver?         @relation("enquiry_assigned_driver", fields: [assigned_driver_id], references: [driver_id], onDelete: SetNull)
  assignedPartner       Partner?        @relation("enquiry_assigned_partner", fields: [assigned_partner_id], references: [partner_id], onDelete: SetNull)
  assignedOwner         VehicleOwner?   @relation("enquiry_assigned_owner", fields: [assigned_owner_id], references: [owner_id], onDelete: SetNull)
  quotedByAdmin         Admin?          @relation("enquiry_quoted_by", fields: [quoted_by_admin_id], references: [admin_id], onDelete: SetNull)
  // The canonical operational Booking created when the customer accepted the
  // final quote. Unique — one Booking is the operational record of exactly one
  // Enquiry. Nullable so an enquiry always survives its Booking.
  booking_id            Int?            @unique
  booking               Booking?        @relation("enquiry_booking", fields: [booking_id], references: [booking_id], onDelete: SetNull)
  events                EnquiryEvent[]

  @@index([enquiry_number], name: "idx_enquiries_number")
  @@index([customer_id], name: "idx_enquiries_customer")
  @@index([booking_id], name: "idx_enquiries_booking")
  @@index([customer_mobile], name: "idx_enquiries_mobile")
  @@index([session_key], name: "idx_enquiries_session")
  @@index([status], name: "idx_enquiries_status")
  @@index([price_status], name: "idx_enquiries_price_status")
  @@index([assigned_driver_id], name: "idx_enquiries_driver")
  @@index([assigned_vehicle_id], name: "idx_enquiries_vehicle")
  @@index([assigned_partner_id], name: "idx_enquiries_partner")
  @@index([pickup_date], name: "idx_enquiries_pickup_date")
  @@index([created_at], name: "idx_enquiries_created")
  @@map("enquiries")
}

// --- Enquiry Event (immutable audit trail + customer activity feed) ---
// Append-only. Every meaningful transition writes exactly one row, which
// powers BOTH the admin audit history and the customer "Request Timeline".
model EnquiryEvent {
  enquiry_event_id  Int               @id @default(autoincrement())
  enquiry_id        Int
  event_type        EnquiryEventType
  actor_type        EnquiryActorType  @default(SYSTEM)
  actor_id          Int?              // admin_id / user_id / driver_id (nullable)
  actor_name        String?
  message           String
  // JSON payload for extra context (e.g. { from, to, vehicle_number }).
  // MUST NEVER contain driver mobile numbers.
  metadata          Json?
  // False for internal-only events that must not appear on the customer feed.
  customer_visible  Boolean           @default(true)
  created_at        DateTime          @default(now())

  // Relations
  enquiry Enquiry @relation(fields: [enquiry_id], references: [enquiry_id], onDelete: Cascade)

  @@index([enquiry_id, created_at], name: "idx_enquiry_events_enquiry")
  @@index([event_type], name: "idx_enquiry_events_type")
  @@index([created_at], name: "idx_enquiry_events_created")
  @@map("enquiry_events")
}

